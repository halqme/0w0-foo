---
import { Font } from "astro:assets";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import { ClientRouter } from "astro:transitions";
import type { TransitionAnimationPair } from "astro";
import { css } from "styled-system/css";
import { token } from "styled-system/tokens";
import {
  pageTransition,
  rootTransition,
  thingsFilterStill,
} from "../styles/motion";
import { containerMain } from "../styles/ui";

const pageAnimation: TransitionAnimationPair = {
  old: {
    name: "page-exit",
    duration: token("durations.fast"),
    easing: "ease-out",
    fillMode: "both",
  },
  new: {
    name: "page-enter",
    duration: token("durations.slow"),
    easing: "ease-out",
    fillMode: "both",
    delay: token("durations.faster"),
  },
};

// oxlint-disable-next-line no-unassigned-import
import "../index.css";

const root = css({
  _motionSafe: { scrollBehavior: "smooth" },
});
const shell = css({
  bg: "canvas",
  color: "ink",
  display: "flex",
  minH: "100dvh",
  flexDirection: "column",
  fontFamily: "sans",
});
const skipLink = css({
  srOnly: true,
  _focus: {
    position: "absolute",
    top: "2",
    left: "2",
    zIndex: "50",
    w: "auto",
    h: "auto",
    m: "0",
    overflow: "visible",
    clip: "auto",
    whiteSpace: "normal",
    borderWidth: "0",
    borderRadius: "sm",
    px: "4",
    py: "2",
    bg: "ink",
    color: "canvas",
  },
});
const mainColumn = css({
  flex: "1 1 0%",
  pt: { base: "6", sm: "8" },
  pb: { base: "16", sm: "20" },
});

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
}

const {
  title,
  description,
  ogImage,
  ogType = "website",
  pubDate,
  modifiedDate,
  tags,
} = Astro.props;

const titled = title ? `${title} | 0w0.foo` : "0w0.foo";

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || Astro.url.origin,
);

// OGP画像を絶対URLに変換
const absoluteOgImage = ogImage
  ? new URL(ogImage, canonicalURL).toString()
  : undefined;
---

<!doctype html>
<html lang="ja" class:list={[root, rootTransition, thingsFilterStill]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="sJQvvU3-0_kqP3PkfIUhC8E_tSSMM12-Ib_VISr1Ax4"
    />
    <ClientRouter />
    <title>{titled}</title>
    <script is:inline>
      (() => {
        const valid = ["auto", "light", "dark"];
        let theme = "auto";
        try {
          const stored = localStorage.getItem("theme");
          if (valid.includes(stored)) theme = stored;
        } catch {}
        const root = document.documentElement;
        root.dataset.theme = theme;
        root.classList.toggle(
          "dark",
          theme === "dark" ||
            (theme === "auto" &&
              matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
    <meta property="og:title" content={titled} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="0w0.foo" />
    <meta property="og:locale" content="ja_JP" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

    <meta
      name="twitter:card"
      content={absoluteOgImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={titled} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    {ogType === "article" && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {ogType === "article" && modifiedDate && (
      <meta
        property="article:modified_time"
        content={modifiedDate.toISOString()}
      />
    )}
    {ogType === "article" &&
      tags &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <Font cssVariable="--font-ia-writer-mono" preload />
    <Font cssVariable="--font-shippori-antique" preload />
    <Font cssVariable="--font-shippori-antique-b1" preload />

    <link rel="canonical" href={canonicalURL} />
  </head>
  <body class={shell}>
    <a href="#main-content" class={skipLink}>
      メインコンテンツへスキップ
    </a>
    <Header />
    <main
      id="main-content"
      transition:name="page-content"
      transition:animate={{ forwards: pageAnimation, backwards: pageAnimation }}
      class:list={[containerMain, mainColumn, pageTransition]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
