---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import { css } from "styled-system/css";
import { link } from "styled-system/recipes";

import Icon from "../components/ui/Icon.astro";
import ShareButtons from "../components/ui/ShareButtons.astro";
import Tag from "../components/ui/Tag.astro";
import TableOfContents from "../components/ui/TableOfContents.astro";

import { slugifyTag } from "../lib/tag";
import {
  articleColumn,
  disclosureTrigger,
  pageHeader,
  textHeadline,
} from "../styles/ui";

import Layout from "./Layout.astro";

const article = css({ py: "8" });
const titleText = css({ overflowWrap: "anywhere" });
const meta = css({
  display: "flex",
  flexWrap: "wrap",
  justifyContent: "center",
  columnGap: "4",
  rowGap: "1",
  fontSize: "sm",
  lineHeight: "1.25rem",
  color: "muted",
});
const tags = css({
  display: "flex",
  maxW: "full",
  flexWrap: "wrap",
  justifyContent: "center",
  columnGap: "4",
  rowGap: "1",
});
const tagItem = css({ minW: "0", maxW: "full" });
const toc = css({ mb: "8", fontSize: "sm", lineHeight: "1.25rem" });
const content = css({ maxW: "none", minW: "0" });
const articleFooter = css({
  mt: "8",
  display: "flex",
  flexDirection: "column",
  alignItems: "flex-start",
  pt: "8",
});
const toTop = css({ alignSelf: "flex-end" });

type Props = CollectionEntry<"blog">["data"] & {
  description: string;
  slug: string;
  readingTime?: string;
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  published_at,
  topics,
  zenn_slug,
  slug,
  readingTime,
  headings,
} = Astro.props;

const ogImage = `/ogp/${slug}.png`;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  pubDate={published_at}
  tags={topics}
>
  <article class:list={[articleColumn, article]} aria-labelledby="post-title">
    <header class={pageHeader}>
      <h1 id="post-title" class:list={[textHeadline, titleText]}>
        {title}
      </h1>
      <div class={meta}>
        <time datetime={published_at.toISOString()}>
          {published_at.toLocaleDateString("ja-JP")}
        </time>
        {readingTime && <span>{readingTime}</span>}
      </div>
      {topics.length > 0 && (
        <ul class={tags}>
          {topics.map((tag: string) => (
            <li class={tagItem}>
              <Tag label={tag} href={`/blog/tags/${slugifyTag(tag)}/`} />
            </li>
          ))}
        </ul>
      )}
      {zenn_slug && (
        <a
          href={`https://zenn.dev/hal227/articles/${zenn_slug}`}
          class={link({ kind: "action" })}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read on Zenn
        </a>
      )}
    </header>

    {headings?.some(
      (heading) => heading.depth === 2 || heading.depth === 3,
    ) && (
      <details class:list={["toc", toc]}>
        <summary class={disclosureTrigger}>
          <Icon name="chevron-right" class="toc-chevron" />
          目次
        </summary>
        <TableOfContents headings={headings} />
      </details>
    )}
    <div class:list={["post-content", "prose", "prose-sm", content]}>
      <slot />
    </div>
    <footer class={articleFooter}>
      <ShareButtons path={Astro.url.pathname} title={title} />
      <button
        type="button"
        class:list={[toTop, link({ kind: "action" })]}
        aria-label="ページ先頭へ戻る"
        onclick="if (location.hash) history.replaceState(history.state, '', location.pathname + location.search); window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })"
      >
        ^ top
      </button>
    </footer>
    <script>
      import { codeBlockWrapper, codeCopyButton, srOnly } from "../styles/ui";

      const NOTIFICATION_DURATION_MS = 5000;

      function addCopyButton(codeBlock: HTMLElement): void {
        if (codeBlock.hasAttribute("data-has-copy-button")) {
          return;
        }
        const codeElement = codeBlock.querySelector("code");
        if (!codeElement) {
          return;
        }
        codeBlock.setAttribute("data-has-copy-button", "true");

        const wrapper = document.createElement("div");
        wrapper.className = codeBlockWrapper;
        wrapper.style.position = "relative";

        if (typeof window !== "undefined") {
          const cs = window.getComputedStyle(codeBlock);
          wrapper.style.marginTop = cs.marginTop;
          wrapper.style.marginBottom = cs.marginBottom;
          wrapper.style.marginLeft = cs.marginLeft;
          wrapper.style.marginRight = cs.marginRight;
          codeBlock.style.margin = "0";
        }

        const liveRegion = document.createElement("div");
        liveRegion.setAttribute("role", "status");
        liveRegion.setAttribute("aria-live", "polite");
        liveRegion.setAttribute("aria-atomic", "true");
        liveRegion.className = srOnly;

        const button = document.createElement("button");
        button.type = "button";
        button.className = codeCopyButton;
        button.innerHTML = `
        <span class="copy-text">コピー</span>
      `;

        let pending = false;
        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        const setState = (copied: boolean, failed = false): void => {
          button.innerHTML = copied
            ? '<span class="copy-text">コピー済</span>'
            : failed
              ? '<span class="copy-text">失敗</span>'
              : '<span class="copy-text">コピー</span>';
        };

        button.addEventListener("click", async (e) => {
          e.preventDefault();
          if (pending) {
            return;
          }

          liveRegion.textContent = "";
          setState(false);
          pending = true;
          button.disabled = true;
          if (resetTimer !== undefined) {
            clearTimeout(resetTimer);
            resetTimer = undefined;
          }

          let failed = false;
          try {
            await navigator.clipboard.writeText(codeElement.textContent ?? "");
            setState(true);
            liveRegion.textContent = "コードをコピーしました";
          } catch (error) {
            console.error("Failed to copy code:", error);
            failed = true;
            setState(false, true);
            liveRegion.textContent = "コピーに失敗しました";
          } finally {
            pending = false;
            button.disabled = false;
            if (!failed) {
              resetTimer = setTimeout(() => {
                setState(false);
                resetTimer = undefined;
              }, NOTIFICATION_DURATION_MS);
            }
          }
        });

        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);
        wrapper.appendChild(button);
        wrapper.appendChild(liveRegion);
      }

      function initCodeCopyButtons(): void {
        document
          .querySelectorAll<HTMLElement>(".astro-code")
          .forEach(addCopyButton);
      }

      initCodeCopyButtons();
      document.addEventListener("astro:page-load", initCodeCopyButtons);
    </script>
  </article>
</Layout>

<style>
  .post-content {
    overflow-wrap: break-word;
  }

  .post-content :global(:is(h1, h2, h3, h4, h5, h6)) {
    font-family: var(--fonts-emphasis);
    font-weight: 400;
    line-height: 1.4;
    margin-block: var(--spacing-8) var(--spacing-4);
  }

  .post-content :global(:is(h1, h2)) {
    font-size: var(--font-sizes-xl);
  }

  .post-content :global(h3) {
    font-size: var(--font-sizes-lg);
  }

  .post-content :global(:is(h4, h5, h6)) {
    font-size: var(--font-sizes-md);
  }

  .toc {
    interpolate-size: allow-keywords;
  }

  .toc-chevron {
    transition: transform var(--durations-fast) ease-out;
  }

  .toc[open] > summary .toc-chevron {
    transform: rotate(90deg);
  }

  /* Native details hides the body immediately, so the height cannot ease closed. */
  .toc::details-content {
    height: 0;
    overflow: clip;
    transition:
      height var(--durations-fast) ease-out,
      content-visibility var(--durations-fast) allow-discrete;
  }

  .toc[open]::details-content {
    height: auto;
  }

  .post-content :global(blockquote) {
    border: 0;
    border-inline-start: 2px solid var(--colors-muted);
    padding-inline-start: var(--spacing-4);
    color: inherit;
    font-style: normal;
    font-weight: 400;
  }

  .post-content :global(blockquote p)::before,
  .post-content :global(blockquote p)::after {
    content: none;
  }

  .post-content :global(strong) {
    font-family: var(--fonts-emphasis);
    font-weight: 400;
  }

  /* The prose disc is the browser bullet. A 1px line matches the site's rules. */
  .post-content :global(ul) {
    list-style: none;
  }

  .post-content :global(ul > li) {
    position: relative;
  }

  .post-content :global(ul > li)::before {
    content: "";
    position: absolute;
    inset-inline-start: -0.875rem;
    top: calc(0.5lh - 0.5px);
    width: var(--spacing-2);
    height: 1px;
    background: var(--colors-muted);
  }

  .post-content :global(pre) {
    border-radius: 0;
    padding-inline-end: 4.5rem;
    overflow: hidden;
  }

  /* Scrolling the pre would move this padding, and the line would pass under the copy button. */
  .post-content :global(pre code) {
    display: block;
    overflow-x: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-content :global(.code-copy-button) {
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--durations-fast) ease-out;
    }

    .post-content :global(.code-block-wrapper:hover .code-copy-button),
    .post-content :global(.code-block-wrapper:focus-within .code-copy-button) {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* A one-line block is shorter than the 40px target placed 8px from the top. */
  @media (hover: none), (pointer: coarse) {
    .post-content :global(pre) {
      min-height: calc(var(--spacing-2) + var(--sizes-10) + var(--spacing-2));
    }

    .post-content :global(.code-copy-button) {
      min-height: var(--sizes-10);
    }
  }
</style>
