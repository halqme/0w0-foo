---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import ShareButtons from "../components/ui/ShareButtons.astro";
import Tag from "../components/ui/Tag.astro";
import TableOfContents from "../components/ui/TableOfContents.astro";

import { slugifyTag } from "../lib/tag";

import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"] & {
  description: string;
  slug: string;
  readingTime?: string;
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  published_at,
  topics,
  zenn_slug,
  slug,
  readingTime,
  headings,
} = Astro.props;

const ogImage = `/ogp/${slug}.png`;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  pubDate={published_at}
  tags={topics}
>
  <article class="article-column py-8" aria-labelledby="post-title">
    <header class="page-header">
      <h1 id="post-title" class="text-headline [overflow-wrap:anywhere]">
        {title}
      </h1>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm text-muted">
        <time datetime={published_at.toISOString()}>
          {published_at.toLocaleDateString("ja-JP")}
        </time>
        {readingTime && <span>{readingTime}</span>}
      </div>
      {topics.length > 0 && (
        <ul class="flex max-w-full flex-wrap justify-center gap-x-4 gap-y-1">
          {topics.map((tag: string) => (
            <li class="min-w-0 max-w-full">
              <Tag label={tag} href={`/tags/${slugifyTag(tag)}`} />
            </li>
          ))}
        </ul>
      )}
      {zenn_slug && (
        <a
          href={`https://zenn.dev/hal227/articles/${zenn_slug}`}
          class="text-action"
          target="_blank"
          rel="noopener noreferrer"
        >
          Read on Zenn
        </a>
      )}
    </header>

    {headings?.some(
      (heading) => heading.depth === 2 || heading.depth === 3,
    ) && (
      <details class="toc mb-8 text-sm">
        <summary class="disclosure-trigger">
          <span
            class="toc-chevron icon-sm i-lucide:chevron-right"
            aria-hidden="true"
          ></span>
          目次
        </summary>
        <TableOfContents headings={headings} />
      </details>
    )}
    <div class="post-content prose prose-sm max-w-none min-w-0">
      <slot />
    </div>
    <footer class="mt-8 flex flex-col items-start pt-8">
      <ShareButtons path={Astro.url.pathname} title={title} />
      <button
        type="button"
        class="self-end text-action"
        aria-label="ページ先頭へ戻る"
        onclick="if (location.hash) history.replaceState(history.state, '', location.pathname + location.search); window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })"
      >
        ^ top
      </button>
    </footer>
    <script>
      const NOTIFICATION_DURATION_MS = 5000;

      function addCopyButton(codeBlock: HTMLElement): void {
        if (codeBlock.hasAttribute("data-has-copy-button")) {
          return;
        }
        const codeElement = codeBlock.querySelector("code");
        if (!codeElement) {
          return;
        }
        codeBlock.setAttribute("data-has-copy-button", "true");

        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper relative block w-full";
        wrapper.style.position = "relative";

        if (typeof window !== "undefined") {
          const cs = window.getComputedStyle(codeBlock);
          wrapper.style.marginTop = cs.marginTop;
          wrapper.style.marginBottom = cs.marginBottom;
          wrapper.style.marginLeft = cs.marginLeft;
          wrapper.style.marginRight = cs.marginRight;
          codeBlock.style.margin = "0";
        }

        const liveRegion = document.createElement("div");
        liveRegion.setAttribute("role", "status");
        liveRegion.setAttribute("aria-live", "polite");
        liveRegion.setAttribute("aria-atomic", "true");
        liveRegion.className = "sr-only";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "code-copy-button";
        button.innerHTML = `
        <span class="copy-text">コピー</span>
      `;

        let pending = false;
        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        const setState = (copied: boolean, failed = false): void => {
          button.innerHTML = copied
            ? '<span class="copy-text">コピー済</span>'
            : failed
              ? '<span class="copy-text">失敗</span>'
              : '<span class="copy-text">コピー</span>';
        };

        button.addEventListener("click", async (e) => {
          e.preventDefault();
          if (pending) {
            return;
          }

          liveRegion.textContent = "";
          setState(false);
          pending = true;
          button.disabled = true;
          if (resetTimer !== undefined) {
            clearTimeout(resetTimer);
            resetTimer = undefined;
          }

          let failed = false;
          try {
            await navigator.clipboard.writeText(codeElement.textContent ?? "");
            setState(true);
            liveRegion.textContent = "コードをコピーしました";
          } catch (error) {
            console.error("Failed to copy code:", error);
            failed = true;
            setState(false, true);
            liveRegion.textContent = "コピーに失敗しました";
          } finally {
            pending = false;
            button.disabled = false;
            if (!failed) {
              resetTimer = setTimeout(() => {
                setState(false);
                resetTimer = undefined;
              }, NOTIFICATION_DURATION_MS);
            }
          }
        });

        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);
        wrapper.appendChild(button);
        wrapper.appendChild(liveRegion);
      }

      function initCodeCopyButtons(): void {
        document
          .querySelectorAll<HTMLElement>(".astro-code")
          .forEach(addCopyButton);
      }

      initCodeCopyButtons();
      document.addEventListener("astro:page-load", initCodeCopyButtons);
    </script>
  </article>
</Layout>

<style>
  .post-content {
    overflow-wrap: break-word;
  }

  .post-content :global(:is(h1, h2, h3, h4, h5, h6)) {
    font-family: var(--font-shippori-antique-b1);
    font-weight: 400;
    line-height: 1.4;
    margin-block: 2rem 1rem;
  }

  .post-content :global(:is(h1, h2)) {
    font-size: 1.25rem;
  }

  .post-content :global(h3) {
    font-size: 1.125rem;
  }

  .post-content :global(:is(h4, h5, h6)) {
    font-size: 1rem;
  }

  .toc {
    interpolate-size: allow-keywords;
  }

  .toc-chevron {
    transition: transform 150ms ease-out;
  }

  .toc[open] > summary .toc-chevron {
    transform: rotate(90deg);
  }

  /* Native details hides the body immediately, so the height cannot ease closed. */
  .toc::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 150ms ease-out,
      content-visibility 150ms allow-discrete;
  }

  .toc[open]::details-content {
    height: auto;
  }

  .post-content :global(blockquote) {
    border: 0;
    border-inline-start: 2px solid var(--color-muted);
    padding-inline-start: 1rem;
    color: inherit;
    font-style: normal;
    font-weight: 400;
  }

  .post-content :global(blockquote p)::before,
  .post-content :global(blockquote p)::after {
    content: none;
  }

  .post-content :global(strong) {
    font-family: var(--font-shippori-antique-b1);
    font-weight: 400;
  }

  /* The prose disc is the browser bullet. A 1px line matches the site's rules. */
  .post-content :global(ul) {
    list-style: none;
  }

  .post-content :global(ul > li) {
    position: relative;
  }

  .post-content :global(ul > li)::before {
    content: "";
    position: absolute;
    inset-inline-start: -0.875rem;
    top: calc(0.5lh - 0.5px);
    width: 0.5rem;
    height: 1px;
    background: var(--color-muted);
  }

  .post-content :global(pre) {
    border-radius: 0;
    padding-inline-end: 4.5rem;
    overflow: hidden;
  }

  /* Scrolling the pre would move this padding, and the line would pass under the copy button. */
  .post-content :global(pre code) {
    display: block;
    overflow-x: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-content :global(.code-copy-button) {
      opacity: 0;
      pointer-events: none;
      transition: opacity 150ms ease-out;
    }

    .post-content :global(.code-block-wrapper:hover .code-copy-button),
    .post-content :global(.code-block-wrapper:focus-within .code-copy-button) {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* A one-line block is shorter than the 40px target placed 8px from the top. */
  @media (hover: none), (pointer: coarse) {
    .post-content :global(pre) {
      min-height: calc(0.5rem + 2.5rem + 0.5rem);
    }

    .post-content :global(.code-copy-button) {
      min-height: 2.5rem;
    }
  }
</style>
