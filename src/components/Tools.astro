---
import Heading2 from "./ui/Heading2.astro";
import LinkCard from "./ui/LinkCard.astro";

import { tools } from "../data/tools";
---

<section class="section" aria-labelledby="skills-title" id="skills">
  <Heading2 title="Tools & Platforms" />

  <ul
    role="list"
    class="grid grid-cols-[fit-content(55%)_auto_minmax(0,1fr)] gap-x-3 gap-y-1"
  >
    {tools.toSorted((a, b) => a.type.localeCompare(b.type)).map((tool, index) => (
      <li
        class="relative col-span-3 grid grid-cols-subgrid items-baseline min-h-10"
        data-tools
      >
        <a
          href={tool.url}
          class="link-text min-w-0 justify-self-start text-start text-sm text-ink focused [overflow-wrap:anywhere]"
          aria-describedby={`skill-card-${index}`}
          data-tools-trigger
        >
          {tool.name}
        </a>
        <span class="text-sm text-muted" aria-hidden="true">
          —
        </span>
        <span class="min-w-0 text-sm text-muted [overflow-wrap:anywhere]">
          {tool.type}
        </span>
        <div
          id={`tool-card-${index}`}
          role="tooltip"
          class="tool-card absolute col-start-2 start-0 top-1/2 z-10 w-80 max-w-[calc(100vw-3rem)] -translate-y-1/2"
          data-tools-card
        >
          <div class="max-h-[60dvh] overflow-y-auto overscroll-contain rounded-md border border-line bg-surface text-ink shadow-popup">
            <LinkCard href={tool.url} />
            <div class="grid gap-1 p-2 text-sm leading-7">
              {tool.comments.map((comment) => (
                <p>{comment}</p>
              ))}
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .tool-card {
    display: none;
  }

  [data-tools]:has([data-tools-trigger]:focus-visible) .tool-card {
    display: block;
  }

  @media (hover: hover) {
    [data-tools]:has([data-tools-trigger]:hover, .tool-card:hover)
      .tool-card {
      display: block;
    }
  }
</style>
