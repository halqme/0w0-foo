---
import { getCollection } from "astro:content";
import { css } from "../../styled-system/css";
import Heading2 from "./ui/Heading2.astro";
import LinkCard from "./ui/LinkCard.astro";
import { section } from "../styles/ui";

const toolsGrid = css({
  display: "grid",
  gridTemplateColumns: "fit-content(55%) auto minmax(0, 1fr)",
  gridAutoRows: "minmax(2.5rem, auto)",
  alignItems: "baseline",
  columnGap: "3",
  rowGap: "1",
});
const toolType = css({
  minW: "0",
  fontSize: "sm",
  lineHeight: "1.25rem",
  color: "muted",
  overflowWrap: "anywhere",
});

const tools = await getCollection("tools");
---

<section class={section} aria-labelledby="skills-title" id="skills">
  <Heading2 title="Tools & Platforms" id="skills-title" />

  <ul role="list" class={toolsGrid}>
    {tools
      .toSorted((a, b) => a.data.type.localeCompare(b.data.type))
      .map((tool) => (
        <li class={css({ display: "contents" })} role="listitem">
          <LinkCard
            id={`tool-${tool.id}`}
            href={tool.data.url}
            label={tool.data.name}
            comments={tool.data.comments}
          />
          <span
            class={css({
              fontSize: "sm",
              lineHeight: "1.25rem",
              color: "muted",
            })}
            aria-hidden="true"
          >
            —
          </span>
          <span class={toolType}>{tool.data.type}</span>
        </li>
      ))}
  </ul>
</section>
