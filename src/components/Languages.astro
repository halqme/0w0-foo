---
import { css } from "../../styled-system/css";
import Heading2 from "./ui/Heading2.astro";
import { section, textLabel } from "../styles/ui";

const groups = css({
  display: "grid",
  gap: "4",
});
const group = css({
  display: "grid",
  gap: "2",
  sm: {
    gridTemplateColumns: "9rem minmax(0, 1fr)",
    gap: "6",
  },
});
const dividedGroup = css({
  display: "grid",
  gap: "2",
  borderTopWidth: "1px",
  borderTopStyle: "solid",
  borderTopColor: "line",
  pt: "4",
  sm: {
    gridTemplateColumns: "9rem minmax(0, 1fr)",
    gap: "6",
  },
});
const label = css({
  pt: "1",
});
const items = css({
  display: "flex",
  minW: "0",
  flexWrap: "wrap",
  columnGap: "6",
  rowGap: "2",
  fontSize: "sm",
  lineHeight: "1.75rem",
  color: "ink",
});
const item = css({
  minW: "0",
  overflowWrap: "anywhere",
});

const langs: string[] = ["TypeScript", "Go", "Swift"];
const frameworks: string[] = ["Vue / Nuxt", "Hono", "Vite / Vite Plus"];
---

<section class={section} aria-labelledby="languages-title" id="languages">
  <Heading2 title="Languages & Frameworks" id="languages-title" />

  <div class={groups}>
    <div class={group}>
      <h3 id="language-list-title" class:list={[textLabel, label]}>
        Languages
      </h3>
      <ul role="list" aria-labelledby="language-list-title" class={items}>
        {langs.map((lang) => (
          <li class={item} data-languages>
            {lang}
          </li>
        ))}
      </ul>
    </div>
    <div class={dividedGroup}>
      <h3 id="framework-list-title" class:list={[textLabel, label]}>
        Frameworks
      </h3>
      <ul role="list" aria-labelledby="framework-list-title" class={items}>
        {frameworks.map((fw) => (
          <li class={item} data-frameworks>
            {fw}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
