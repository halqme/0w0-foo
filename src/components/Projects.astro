---
import { getCollection } from "astro:content";
import { css } from "styled-system/css";
import Heading2 from "./ui/Heading2.astro";
import LinkCard from "./ui/LinkCard.astro";
import { focused, linkText, section, textLabel } from "../styles/ui";

const projectList = css({
  display: "grid",
  gap: { base: "6", sm: "8" },
});
const titleRow = css({
  mb: "1",
  display: "flex",
  flexWrap: "wrap",
  alignItems: "baseline",
  columnGap: "3",
  rowGap: "1",
});
const separator = css({
  mx: "2",
});
const tags = css({
  display: "flex",
  minW: "0",
  flexWrap: "wrap",
  columnGap: "3",
  rowGap: "1",
  listStyle: "none",
  overflowWrap: "anywhere",
});
const description = css({
  fontSize: "sm",
  lineHeight: { base: "normal", sm: "1.75rem" },
  color: "muted",
  overflowWrap: "anywhere",
});
const detailLink = css({
  mx: "2",
  textAlign: "start",
  fontSize: "sm",
  lineHeight: "1.25rem",
  color: "ink",
  overflowWrap: "break-word",
});

const projects = (await getCollection("works")).slice(0, 4);
---

<section class={section} aria-labelledby="projects-title" id="projects">
  <Heading2 title="Projects" />

  <ul class={projectList}>
    {projects.map((project) => (
      <li
        class={css({ minW: "0" })}
        aria-labelledby={`project-title-${project.id}`}
      >
        <div class={titleRow}>
          <LinkCard
            id={`project-title-${project.id}`}
            href={project.data.repo}
            label={project.data.title}
          />
          {project.data.tags.length > 0 && (
            <>
              <span class:list={[textLabel, separator]}>|</span>
              <ul class:list={[textLabel, tags]} aria-label="使用技術">
                {project.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </>
          )}
        </div>
        <p class={description} lang="en">
          {project.data.description}
          <a
            class:list={[linkText, focused, detailLink]}
            href={`/works/${project.id}`}
          >
            [more detail]
          </a>
        </p>
      </li>
    ))}
  </ul>
</section>
