---
import Heading2 from "./ui/Heading2.astro";

const projects: {
  description: string;
  name: string;
  tag: string[];
  url: string;
}[] = [
  {
    description:
      "An ultra-fast dependency graph generator built with Oxc, inspired by madge.",
    name: "oxdg",
    tag: ["TypeScript", "oxc", "madge"],
    url: "https://github.com/halqme/oxdg",
  },
  {
    description: "A Markdown slide generator and presentation tool.",
    name: "bundeck",
    tag: ["TypeScript", "Bun", "Solid"],
    url: "https://github.com/halqme/bundeck",
  },
  {
    description: "A CLI wrapper for Bun.secrets.",
    name: "@halqme/bunlt",
    tag: ["TypeScript", "Bun"],
    url: "https://github.com/halqme/bunlt",
  },
  {
    description: "Declarative TUI framework for Bun.",
    name: "btuin",
    tag: ["TypeScript", "Bun", "Zig"],
    url: "https://github.com/halqme/btuin",
  },
  {
    description: "Tiny dictation app.",
    name: "Dicta",
    tag: ["Swift", "FluidAudio"],
    url: "https://github.com/halqme/Dicta",
  },
  {
    description: "Extensions and skills for Pi.",
    name: "Pi-Kit",
    tag: ["TypeScript"],
    url: "https://github.com/halqme/pi-kit",
  },
  {
    description: "The skills for programer and japanese.",
    name: "skills",
    tag: [],
    url: "https://github.com/halqme/skills",
  },
  {
    description: "Fastfetch for the web.",
    name: "browserfetch",
    tag: ["Vue","TypeScript"],
    url: "https://browserfetch.apps.0w0.foo",
  },
];
---

<section class="section" aria-labelledby="projects-title" id="projects">
  <Heading2 title="Projects" />

  <div class="grid gap-6 sm:gap-8">
    {[projects.slice(0, 4), projects.slice(4)].map((group, groupIndex) => {
      const Container = groupIndex === 1 ? "details" : "div";
      return (
        <Container id={groupIndex === 1 ? "additional-projects" : undefined}>
          {groupIndex === 1 && (
            <summary class="disclosure-trigger">もっと見る</summary>
          )}
          <div class:list={["grid gap-6 sm:gap-8", groupIndex === 1 && "mt-4"]}>
            {group.map((project, index) => {
              const projectIndex = index + (groupIndex === 1 ? 4 : 0);
              return (
                <article
                  class="min-w-0"
                  aria-labelledby={`project-title-${projectIndex}`}
                >
                  <div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3
                      id={`project-title-${projectIndex}`}
                      class="list-title min-w-0"
                    >
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-text"
                      >
                        {project.name}
                      </a>
                    </h3>
                    {project.tag.length > 0 && (
                      <>
                        <span class="text-label mx-2">|</span>
                        <ul
                          class="text-label min-w-0 flex flex-wrap gap-x-3 gap-y-1 list-none [overflow-wrap:anywhere]"
                          aria-label="使用技術"
                        >
                          {project.tag.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      </>
                    )}
                  </div>
                  <p
                    class="text-sm leading-normal text-muted [overflow-wrap:anywhere] sm:leading-7"
                    lang="en"
                  >
                    {project.description}
                  </p>
                </article>
              );
            })}
            {groupIndex === 1 && (
              <a
                class="text-action w-fit"
                href="https://github.com/halqme?tab=repositories"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHubでもっと見る
              </a>
            )}
          </div>
        </Container>
      );
    })}
  </div>
</section>
