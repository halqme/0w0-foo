---
import { getCollection } from "astro:content";
import Heading2 from "./ui/Heading2.astro";
import LinkCard from "./ui/LinkCard.astro";

const projects = (await getCollection("works")).slice(0, 4);
---

<section class="section" aria-labelledby="projects-title" id="projects">
  <Heading2 title="Projects" />

  <ul class="grid gap-6 sm:gap-8">
    {projects.map((project) => (
      <li class="min-w-0" aria-labelledby={`project-title-${project.id}`}>
        <div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <LinkCard
            id={`project-title-${project.id}`}
            href={project.data.repo}
            label={project.data.title}
          />
          {project.data.tags.length > 0 && (
            <>
              <span class="text-label mx-2">|</span>
              <ul
                class="text-label min-w-0 flex flex-wrap gap-x-3 gap-y-1 list-none [overflow-wrap:anywhere]"
                aria-label="使用技術"
              >
                {project.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </>
          )}
        </div>
        <p
          class="text-sm leading-normal text-muted [overflow-wrap:anywhere] sm:leading-7"
          lang="en"
        >
          {project.data.description}
          <a
            class="link-text text-start text-sm text-ink focused mx-2 [overflow-wrap:break-word]"
            href={`/works/${project.id}`}
          >
            [more detail]
          </a>
        </p>
      </li>
    ))}
  </ul>
</section>
