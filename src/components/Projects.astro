---
import Heading2 from "./ui/Heading2.astro";

const projects: {
  description: string;
  name: string;
  tag: string[];
  url: string;
}[] = [
  {
    description:
      "次世代のmadge。oxc-toolchainによる高速なdependency-graph生成CLI",
    name: "oxdg",
    tag: ["TypeScript", "oxc", "madge"],
    url: "https://github.com/halqme/oxdg",
  },
  {
    description:
      "Markdownでスライドを作成できるBun製ツール。marpみたいだけど、プレゼン機能が充実している",
    name: "bundeck",
    tag: ["TypeScript", "Bun", "Solid"],
    url: "https://github.com/halqme/bundeck",
  },
  {
    description: "Bun.secrets WrapperなCLI",
    name: "@halqme/bunlt",
    tag: ["TypeScript", "Bun", "Sercret-Manager"],
    url: "https://github.com/halqme/bunlt",
  },
  {
    description: "大阪公立大学合氣道部の情報基盤。モノレポ",
    name: "omu-aikido/foundation",
    tag: ["TypeScript", "Hono", "Vue.js", "nuxt"],
    url: "https://github.com/omu-aikido/foundation",
  },
  {
    description: "Bun向けの宣言的TUIフレームワーク。レイアウトエンジンはZig",
    name: "btuin",
    tag: ["TypeScript", "Bun", "Zig"],
    url: "https://github.com/halqme/btuin",
  },
  {
    description:
      "Apple Foundation Models用CLIチャットツール。macOS 27からはfmを使うので要らない",
    name: "Fai",
    tag: ["Swift"],
    url: "https://github.com/halqme/Fai",
  },
  {
    description:
      "極小の音声入力アプリ。音声入力にハマったときに作りかけて、そのまま",
    name: "Dicta",
    tag: ["Swift"],
    url: "https://github.com/halqme/Dicta",
  },
  {
    description:
      "Piの拡張機能・スキルのセット。GPT-Lunaシリーズなど高効率モデルのために設計。タスクを失敗せずに走りきることに注力している",
    name: "Pi-Kit",
    tag: ["Pi-Coding-Agent", "TypeScript"],
    url: "https://github.com/halqme/pi-kit",
  },
  {
    description: "普段使っているスキルたち",
    name: "skills",
    tag: [],
    url: "https://github.com/halqme/skills",
  },
  {
    description:
      "fastfetchカッコいい！と思った結果webのコンテキストにおけるfetchのややこしさを見事に踏み抜いた逸品",
    name: "browserfetch",
    tag: [],
    url: "https://browserfetch.apps.0w0.foo",
  },
];
---

<section class="section" aria-labelledby="projects-title" id="projects">
  <Heading2 icon="i-lucide:folder-git-2" title="Projects" />

  <div class="grid p-3 sm:p-5 bg-[color-mix(in_srgb,var(--color-pink)_13%,var(--color-canvas))]">
    {[projects.slice(0, 4), projects.slice(4)].map((group, groupIndex) => (
      <div
        class:list={[groupIndex === 1 ? "projects-collapse" : undefined]}
        id={groupIndex === 1 ? "additional-projects" : undefined}
      >
        <div class="projects-collapse-inner grid grid-cols-1 sm:grid-cols-2 gap-x-4 sm:gap-x-10">
          {group.map((project, index) => {
            const projectIndex = index + (groupIndex === 1 ? 4 : 0);
            return (
              <article
                class="min-w-0 border-t border-line/70"
                aria-labelledby={`project-title-${projectIndex}`}
              >
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link block min-w-0 h-full py-4 sm:py-5 text-ink no-underline"
                  aria-labelledby={`project-title-${projectIndex}`}
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <h3
                      id={`project-title-${projectIndex}`}
                      class="min-w-0 mb-2 font-medium font-mono text-xl leading-tight tracking-tight [overflow-wrap:anywhere]"
                    >
                      <span class="motion-underline">{project.name}</span>
                    </h3>
                    <span
                      class="icon-sm text-muted i-lucide:arrow-up-right"
                      aria-hidden="true"
                    />
                  </div>
                  <p class="max-w-[65ch] mb-3 text-base leading-relaxed text-muted [text-wrap:pretty]">
                    {project.description}
                  </p>
                  {project.tag.length > 0 && (
                    <ul
                      class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 font-mono text-xs leading-relaxed text-muted"
                      aria-label="使用技術"
                    >
                      {project.tag.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                </a>
              </article>
            );
          })}
          {groupIndex === 1 && (
            <a
              class="project-link inline-block mb-2 ml-auto text-ink motion-underline sm:col-span-2"
              href="https://github.com/halqme?tab=repositories"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHubでもっと見る →
            </a>
          )}
        </div>
      </div>
    ))}

    <button
      id="projects-toggle"
      class="btn-ghost mx-auto mt-4"
      type="button"
      aria-expanded="true"
      aria-controls="additional-projects"
      data-expand-label={`（﹀ もっと見る ﹀）`}
      hidden
    >
      （︿ 折りたたむ ︿）
    </button>
  </div>

  <script>
    function initProjects() {
      const projectsSection = document.querySelector("#projects");
      const toggle = projectsSection?.querySelector("#projects-toggle");
      const additionalProjects = projectsSection?.querySelector<HTMLElement>(
        "#additional-projects",
      );

      if (
        toggle instanceof HTMLButtonElement &&
        additionalProjects &&
        toggle.dataset.initialized !== "true"
      ) {
        toggle.dataset.initialized = "true";
        const expandLabel = toggle.dataset.expandLabel ?? "表示";
        additionalProjects.inert = true;
        additionalProjects.classList.remove("is-expanded");
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = expandLabel;
        projectsSection?.classList.add("projects-enhanced");
        toggle.hidden = false;

        void additionalProjects.offsetHeight;
        requestAnimationFrame(() => {
          if (projectsSection?.isConnected) {
            projectsSection.classList.add("projects-transitions-ready");
          }
        });

        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!expanded));
          toggle.textContent = expanded ? expandLabel : "（︿ 折りたたむ ︿）";
          additionalProjects.inert = expanded;
          additionalProjects.classList.toggle("is-expanded", !expanded);
        });
      }
    }

    initProjects();
    document.addEventListener("astro:page-load", initProjects);
  </script>
  <style>
    #projects-toggle[hidden] {
      display: none;
    }

    .projects-collapse {
      display: grid;
      grid-template-rows: 1fr;
    }

    .projects-collapse > .projects-collapse-inner {
      min-height: 0;
      overflow: hidden;
    }

    .projects-enhanced .projects-collapse {
      grid-template-rows: 0fr;
    }

    .projects-enhanced .projects-collapse.is-expanded {
      grid-template-rows: 1fr;
    }

    @media (prefers-reduced-motion: no-preference) {
      .projects-transitions-ready .projects-collapse {
        transition: grid-template-rows 250ms ease;
      }
    }
  </style>
</section>
