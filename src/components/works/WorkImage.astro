---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { css } from "../../../styled-system/css";

const figure = css({ my: "8", bg: "surface.muted" });
const image = css({ display: "block", h: "auto", w: "full" });

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class={figure}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 832, 1200, 1600]}
    sizes="(min-width: 896px) 832px, (min-width: 640px) calc(100vw - 64px), calc(100vw - 48px)"
    class={image}
    loading="lazy"
  />
</figure>
