---
import { Image } from "astro:assets";

import Socials from "./ui/Socials.astro";

const profile: {
  description: string;
  category: {
    name: string;
    desc: string[];
  }[];
} = {
  description: "見習いシステムエンジニア",
  category: [
    {
      name: "趣味",
      desc: ["音楽", "映画", "合気道（二段）"],
    },
    {
      name: "分野",
      desc: ["Web系（主戦場）", "実験心理学（専攻）"],
    },
  ],
};
---

<section class="section" aria-labelledby="about-title" id="about">
  <div class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-4 sm:grid-cols-[3.5rem_minmax(0,1fr)_auto] sm:gap-x-6">
    <Image
      src="/chappie-selfie.jpg"
      width="128"
      height="128"
      class="size-14 shrink-0 rounded-full object-cover"
      alt="僕のChatGPTの自認顔"
      loading="eager"
    />

    <div class="min-w-0 text-start">
      <h1 id="about-title" class="text-headline">
        HAL
      </h1>
      <p class="text-sm leading-7 text-muted">{profile.description}</p>
    </div>

    <dl class="col-span-2 grid min-w-0 gap-2 text-start sm:col-span-1">
      {profile.category.map((cat) => (
        <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 text-sm leading-7">
          <dt class="text-muted">{cat.name}</dt>
          <dd class="m-0 text-muted [overflow-wrap:anywhere]">
            {cat.desc.join(" ◦ ")}
          </dd>
        </div>
      ))}
    </dl>

    <div class="col-span-2 flex flex-wrap gap-x-5 sm:col-span-3">
      <Socials />
    </div>
  </div>
</section>
