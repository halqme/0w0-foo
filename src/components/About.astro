---
import { Image } from "astro:assets";

import Socials from "./ui/Socials.astro";

const profile: {
  description: string;
  category: {
    name: string;
    desc: string[];
  }[];
} = {
  description: "見習いシステムエンジニア",
  category: [
    {
      name: "趣味",
      desc: ["音楽", "映画", "合気道（二段）"],
    },
    {
      name: "分野",
      desc: ["Web系（主戦場）", "実験心理学（専攻）"],
    },
  ],
};
---

<section class="section" aria-labelledby="about-title" id="about">
  <div class="flex flex-col items-center gap-6 text-center">
    <Image
      src="/chappie-selfie.jpg"
      width="128"
      height="128"
      class="size-14 shrink-0 rounded-full object-cover"
      alt="僕のChatGPTの自認顔"
      loading="eager"
    />

    <div class="min-w-0 w-full">
      <h1 id="about-title" class="text-headline mb-2">
        HAL
      </h1>
      <p class="text-base leading-8 text-muted">{profile.description}</p>
      <div class="mt-3 flex flex-wrap justify-center gap-x-5">
        <Socials />
      </div>

      <dl class="mx-auto mt-6 grid w-fit max-w-full gap-2 text-start">
        {profile.category.map((cat) => (
          <div class="grid grid-cols-[3rem_minmax(0,1fr)] gap-3 text-sm leading-7">
            <dt class="text-muted text-end">{cat.name}</dt>
            <dd class="m-0 text-muted [overflow-wrap:anywhere]">
              {cat.desc.join(" ◦ ")}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
