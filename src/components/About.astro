---
import { Image } from "astro:assets";
import { css } from "../../styled-system/css";

import Socials from "./ui/Socials.astro";
import { section, textHeadline } from "../styles/ui";

const aboutGrid = css({
  display: "grid",
  gridTemplateColumns: "3.5rem minmax(0, 1fr)",
  alignItems: "center",
  columnGap: "4",
  rowGap: "4",
  sm: {
    gridTemplateColumns: "3.5rem minmax(0, 1fr) auto",
    columnGap: "6",
  },
});
const avatar = css({
  w: "14",
  h: "14",
  flexShrink: "0",
  borderRadius: "full",
  objectFit: "cover",
});
const identity = css({
  minW: "0",
  textAlign: "start",
});
const bio = css({
  fontSize: "sm",
  lineHeight: "1.75rem",
  color: "muted",
});
const facts = css({
  display: "grid",
  gridColumn: { base: "span 2 / span 2", sm: "span 1 / span 1" },
  minW: "0",
  gap: "2",
  textAlign: "start",
});
const fact = css({
  display: "grid",
  gridTemplateColumns: "6rem minmax(0, 1fr)",
  gap: "3",
  fontSize: "sm",
  lineHeight: "1.75rem",
});
const factValue = css({
  m: "0",
  color: "muted",
  overflowWrap: "anywhere",
});
const socialRow = css({
  display: "flex",
  flexWrap: "wrap",
  gridColumn: { base: "span 2 / span 2", sm: "span 3 / span 3" },
  columnGap: "5",
});

const profile: {
  description: string;
  category: {
    name: string;
    desc: string[];
  }[];
} = {
  description: "見習いシステムエンジニア",
  category: [
    {
      name: "分野",
      desc: ["Web系"],
    },
    {
      name: "専攻・研究",
      desc: ["実験心理学", "LLM"],
    },
    {
      name: "活動場所",
      desc: ["大阪"],
    },
  ],
};
---

<section class={section} aria-labelledby="about-title" id="about">
  <div class={aboutGrid}>
    <Image
      src="/chappie-selfie.jpg"
      width="128"
      height="128"
      class={avatar}
      alt="僕のChatGPTの自認顔"
      loading="eager"
    />

    <div class={identity}>
      <h1 id="about-title" class={textHeadline}>
        HAL
      </h1>
      <p class={bio}>{profile.description}</p>
    </div>

    <dl class={facts}>
      {profile.category.map((cat) => (
        <div class={fact}>
          <dt class={css({ color: "muted" })}>{cat.name}</dt>
          <dd class={factValue}>{cat.desc.join(" ◦ ")}</dd>
        </div>
      ))}
    </dl>

    <div class={socialRow}>
      <Socials />
    </div>
  </div>
</section>
