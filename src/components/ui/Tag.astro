---
interface Props {
  label: string;
  href?: string;
  active?: boolean;
  count?: number;
  icon?: string;
  class?: string;
}

const {
  label,
  href,
  active = false,
  count,
  class: className = "",
} = Astro.props;

const baseClasses = [
  "inline-flex min-h-6 max-w-full items-baseline gap-2 py-0.5 text-xs font-normal [overflow-wrap:anywhere]",
  active ? "text-ink underline" : "text-muted",
  href ? "hover:text-ink" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{href ? (
  <a href={href} class={baseClasses} aria-current={active ? "page" : undefined}>
    <span class="min-w-0">{label}</span>
    {count !== undefined && <span class="shrink-0 text-muted">{count}</span>}
  </a>
) : (
  <span class={baseClasses}>
    <span class="min-w-0">{label}</span>
    {count !== undefined && <span class="shrink-0 text-muted">{count}</span>}
  </span>
)}
