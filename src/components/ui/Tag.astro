---
import type { HTMLAttributes } from "astro/types";
import { css } from "../../../styled-system/css";

const tag = css({
  display: "inline-flex",
  minH: "6",
  maxW: "full",
  alignItems: "baseline",
  gap: "2",
  py: "0.5",
  fontSize: "sm",
  lineHeight: "1.25rem",
  fontWeight: "normal",
  color: "muted",
  overflowWrap: "anywhere",
  "&[aria-current=page]": { color: "ink" },
});
const tagLink = css({
  display: "inline-flex",
  minH: "6",
  maxW: "full",
  alignItems: "baseline",
  gap: "2",
  py: "0.5",
  fontSize: "sm",
  lineHeight: "1.25rem",
  fontWeight: "normal",
  color: "muted",
  overflowWrap: "anywhere",
  "&[aria-current=page]": { color: "ink" },
  _hover: { color: "ink" },
});
const labelText = css({ minW: "0" });
const countText = css({ flexShrink: "0", color: "muted" });

interface Props {
  label: string;
  href?: string;
  active?: boolean;
  count?: number;
  icon?: string;
  class?: string;
  "aria-current"?: HTMLAttributes<"a">["aria-current"];
  [key: `data-${string}`]: string | number | boolean | null | undefined;
}

const {
  label,
  href,
  active = false,
  count,
  icon,
  class: className = "",
  "aria-current": ariaCurrent,
  ...attrs
} = Astro.props;

const current = ariaCurrent ?? (active ? "page" : undefined);
const tone = href ? tagLink : tag;
---

{href ? (
  <a
    href={href}
    class:list={[tone, className]}
    {...attrs}
    aria-current={current}
  >
    <span class={labelText}>{label}</span>
    {count !== undefined && <span class={countText}>{count}</span>}
  </a>
) : (
  <span class:list={[tone, className]} {...attrs} aria-current={current}>
    <span class={labelText}>{label}</span>
    {count !== undefined && <span class={countText}>{count}</span>}
  </span>
)}
