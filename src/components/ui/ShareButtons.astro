---
import { css } from "styled-system/css";
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import { focused, srOnly } from "../../styles/ui";

interface Props {
  path: string;
  title: string;
}

const { path, title } = Astro.props;

const url = `${Astro.site?.protocol}//${Astro.site?.host}${path}`;

const shareItems: {
  ariaLabel: string;
  href: string;
  name: IconName;
  key: string;
  label: string;
}[] = [
  {
    ariaLabel: "Xでシェア",
    href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title + " " + url)}`,
    name: "x",
    key: "x",
    label: "Xでシェア",
  },
  {
    ariaLabel: "Blueskyでシェア",
    href: `https://bsky.app/intent/compose?text=${encodeURIComponent(title + " " + url)}`,
    name: "bluesky",
    key: "bluesky",
    label: "Blueskyでシェア",
  },
  {
    ariaLabel: "Mastodonでシェア",
    href: `https://mastodonshare.com/?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
    name: "mastodon",
    key: "mastodon",
    label: "Mastodonでシェア",
  },
  {
    ariaLabel: "はてブに追加",
    href: `https://b.hatena.ne.jp/entry/panel/?url=${encodeURIComponent(url)}&btitle=${encodeURIComponent(title)}`,
    name: "hatenabookmark",
    key: "hatena",
    label: "はてブに追加",
  },
  {
    ariaLabel: "Facebookでシェア",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
    name: "facebook",
    key: "facebook",
    label: "Facebookでシェア",
  },
];

const row = css({
  display: "flex",
  w: "full",
  flexWrap: "wrap",
  alignItems: "center",
  justifyContent: "center",
  gap: "2",
});
const button = css({
  position: "relative",
  display: "inline-flex",
  h: "11",
  w: "11",
  flexShrink: "0",
  alignItems: "center",
  justifyContent: "center",
  borderRadius: "sm",
  color: "muted",
  _hover: { color: "ink" },
});
const copyIcons = css({ display: "inline-grid" });
---

<div class:list={["share-buttons", row]} role="group" aria-label="記事をシェア">
  {shareItems.map((item) => (
    <button
      type="button"
      data-share-url={item.href}
      class:list={["share-btn", button, focused]}
      aria-label={`${item.ariaLabel}（新しいタブで開く）`}
    >
      <Icon name={item.name} size="md" />
      <span class="share-tooltip" aria-hidden="true">
        {item.label}
      </span>
    </button>
  ))}

  <button
    type="button"
    class:list={["share-btn", "copy-btn", button, focused]}
    data-url={url}
    aria-label="URLをコピー"
  >
    <span
      class:list={["copy-icons", copyIcons]}
      data-state="idle"
      data-copy-icon
    >
      <Icon name="link" size="md" marker="link" />
      <Icon name="check" size="md" marker="check" />
      <Icon name="alert" size="md" marker="alert" />
    </span>
    <span class="share-tooltip" data-copy-tooltip aria-hidden="true">
      URLをコピー
    </span>
  </button>
</div>
<div role="status" aria-live="polite" aria-atomic="true" class={srOnly}></div>

<style>
  .share-tooltip {
    position: absolute;
    left: 50%;
    inset-block-end: 100%;
    transform: translateX(-50%);
    z-index: 10;
    inline-size: max-content;
    max-inline-size: 10rem;
    padding: 4px 8px;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.5;
    visibility: hidden;
    opacity: 0;
  }

  @media (width < 40rem) {
    .share-tooltip {
      max-inline-size: 5rem;
    }
  }

  .share-btn:focus .share-tooltip {
    visibility: visible;
    opacity: 1;
  }

  @media (hover: hover) {
    .share-btn:hover .share-tooltip {
      visibility: visible;
      opacity: 1;
    }
  }

  .share-buttons[data-tooltip-dismissed] .share-tooltip {
    visibility: hidden;
    opacity: 0;
  }

  .copy-icons > :global([data-icon]) {
    grid-area: 1 / 1;
  }

  .copy-icons[data-state="idle"] > :global([data-icon]:not([data-icon="link"])),
  .copy-icons[data-state="copied"]
    > :global([data-icon]:not([data-icon="check"])),
  .copy-icons[data-state="failed"]
    > :global([data-icon]:not([data-icon="alert"])) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .share-tooltip {
      transition: opacity 150ms ease-out;
    }
  }
</style>

<script>
  const NOTIFICATION_DURATION_MS = 5000;

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-share-url]");
    const shareUrl = button?.dataset.shareUrl;
    if (shareUrl) window.open(shareUrl, "_blank", "noopener,noreferrer");
  });

  const initCopyButtons = () => {
    document
      .querySelectorAll<HTMLButtonElement>(".copy-btn")
      .forEach((button) => {
        if (button.hasAttribute("data-copy-initialized")) return;
        button.setAttribute("data-copy-initialized", "true");
        const group = button.closest<HTMLElement>(".share-buttons");
        group?.addEventListener("keydown", (event) => {
          if (event.key === "Escape") group.dataset.tooltipDismissed = "";
        });
        const showTooltip = () => {
          if (group) delete group.dataset.tooltipDismissed;
        };
        group?.addEventListener("focusin", showTooltip);
        group?.addEventListener("pointerover", showTooltip);

        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        let pending = false;
        button.addEventListener("click", async () => {
          const url = button.dataset.url;
          if (!url || pending) return;

          if (resetTimer !== undefined) {
            clearTimeout(resetTimer);
            resetTimer = undefined;
          }
          const liveRegion =
            button.closest(".share-buttons")?.nextElementSibling;
          const label = button.querySelector<HTMLElement>(
            "[data-copy-tooltip]",
          );
          const icon = button.querySelector<HTMLElement>("[data-copy-icon]");
          const resetCopyState = () => {
            if (label) label.textContent = "URLをコピー";
            if (icon) icon.dataset.state = "idle";
            button.setAttribute("aria-label", "URLをコピー");
          };
          if (liveRegion?.getAttribute("role") === "status") {
            liveRegion.textContent = "";
          }
          resetCopyState();
          pending = true;
          button.disabled = true;

          try {
            await navigator.clipboard.writeText(url);
            if (label) label.textContent = "コピー完了！";
            if (icon) icon.dataset.state = "copied";
            button.setAttribute("aria-label", "コピー完了！");
            resetTimer = setTimeout(() => {
              resetCopyState();
              resetTimer = undefined;
            }, NOTIFICATION_DURATION_MS);
            if (liveRegion?.getAttribute("role") === "status") {
              liveRegion.textContent = "URLをコピーしました";
            }
          } catch (error) {
            console.error("Failed to copy URL:", error);
            if (label) label.textContent = "コピーに失敗しました";
            if (icon) icon.dataset.state = "failed";
            button.setAttribute("aria-label", "コピーに失敗しました");
            if (liveRegion?.getAttribute("role") === "status") {
              liveRegion.textContent = "コピーに失敗しました";
            }
          } finally {
            pending = false;
            button.disabled = false;
          }
        });
      });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyButtons);
  } else {
    initCopyButtons();
  }
  document.addEventListener("astro:page-load", initCopyButtons);
</script>
