---
import { css } from "styled-system/css";
import ThemeToggle from "../ui/ThemeToggle.astro";
import { containerMain, navLabel } from "../../styles/ui";

const lineShown = { backgroundSize: "100% 1px, 100% 1px" } as const;
const fineHover = "@media (hover: hover) and (pointer: fine)";

const bar = css({
  display: "flex",
  minH: "20",
  alignItems: "center",
  justifyContent: "space-between",
  pt: { base: "6", sm: "10" },
});
const cluster = css({
  display: "flex",
  alignItems: "center",
  gap: { base: "2", sm: "4" },
});
const row = css({
  display: "flex",
  alignItems: "center",
});
const headerLink = css({
  display: "inline-flex",
  minH: "10",
  alignItems: "center",
  fontFamily: "mono",
  fontSize: "sm",
  lineHeight: "none",
  color: "muted",
  _hover: { color: "ink" },
  "&[aria-current=page], &[aria-current=location]": {
    color: "ink",
    "& [data-nav-label]": lineShown,
  },
  "&:focus-visible [data-nav-label], &:active [data-nav-label]": lineShown,
  [fineHover]: {
    "&:hover [data-nav-label]": lineShown,
  },
  _highContrast: {
    "&:is(:hover, :focus-visible, [aria-current]) [data-nav-label]": {
      textDecorationLine: "underline",
      textUnderlineOffset: "4px",
    },
  },
});

const links: { href: string; label: string }[] = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/works", label: "Works" },
  { href: "/things", label: "Things" },
];
const pathname = Astro.url.pathname;
---

<header class:list={[containerMain, bar]}>
  <div aria-hidden="true" />
  <div class={cluster}>
    <nav class={row} aria-label="メインナビゲーション">
      <ul class={cluster}>
        {links.map((link) => (
          <li class={row}>
            <a
              href={link.href}
              class={headerLink}
              aria-current={
                pathname === link.href || pathname === `${link.href}/`
                  ? "page"
                  : pathname.startsWith(`${link.href}/`)
                    ? "location"
                    : undefined
              }
            >
              <span class={navLabel} data-nav-label>
                {link.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
