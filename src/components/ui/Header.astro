---
import { css } from "styled-system/css";
import { link } from "styled-system/recipes";
import ThemeToggle from "../ui/ThemeToggle.astro";
import { containerMain } from "../../styles/ui";

const bar = css({
  display: "flex",
  minH: "20",
  alignItems: "center",
  justifyContent: "space-between",
  pt: { base: "6", sm: "10" },
});
const cluster = css({
  display: "flex",
  alignItems: "center",
  gap: { base: "2", sm: "4" },
});
const row = css({
  display: "flex",
  alignItems: "center",
});
const headerLink = css({
  display: "inline-flex",
  minH: "10",
  alignItems: "center",
  fontFamily: "mono",
  fontSize: "sm",
  lineHeight: "none",
  color: "muted",
  _hover: { color: "ink" },
  "&[aria-current=page], &[aria-current=location]": { color: "ink" },
});

const links: { href: string; label: string }[] = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/works/", label: "Works" },
  { href: "/things/", label: "Things" },
];
const pathname = Astro.url.pathname;
---

<header class:list={[containerMain, bar]}>
  <div aria-hidden="true" />
  <div class={cluster}>
    <nav class={row} aria-label="メインナビゲーション">
      <ul class={cluster}>
        {links.map((item) => (
          <li class={row}>
            <a
              href={item.href}
              class:list={["group", headerLink]}
              aria-current={
                pathname === item.href || pathname === `${item.href}/`
                  ? "page"
                  : pathname.startsWith(`${item.href}/`)
                    ? "location"
                    : undefined
              }
            >
              <span class={link({ trigger: "group", rest: "none" })}>
                {item.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
