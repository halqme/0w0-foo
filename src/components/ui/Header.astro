---
import ThemeToggle from "../ui/ThemeToggle.astro";

const links = [{ href: "/blog", label: "Blog" }];
const pathname = Astro.url.pathname;
---

<header class="container-main flex min-h-20 items-center justify-between pt-6 sm:pt-10">
  <a
    class="font-mono text-lg font-medium tracking-[-0.07em] text-ink no-underline"
    href="/"
    aria-label="0w0.foo — ホーム"
  >
    0w0<span class="text-accent">.foo</span>
  </a>
  <div class="flex items-center gap-2 sm:gap-4">
    <nav class="flex items-center" aria-label="メインナビゲーション">
      <ul class="flex items-center gap-2 sm:gap-4">
        {links.map((link) => (
          <li class="flex items-center">
            <a
              href={link.href}
              class="header-link inline-flex min-h-10 items-center font-mono text-sm leading-none text-muted hover:text-ink aria-[current=page]:text-ink aria-[current=location]:text-ink"
              aria-current={
                pathname === link.href || pathname === `${link.href}/`
                  ? "page"
                  : pathname.startsWith(`${link.href}/`)
                    ? "location"
                    : undefined
              }
            >
              <span class="motion-underline">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
