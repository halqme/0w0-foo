---
import type { CollectionEntry } from "astro:content";
import Tag from "./Tag.astro";
import { slugifyTag } from "../../lib/tag";

interface Props {
  post: CollectionEntry<"blog">;
  activeTag?: string | null;
}

const { post, activeTag = null } = Astro.props;

const isActiveTag = (tag: string) => activeTag === slugifyTag(tag);
---

<article class="py-4" transition:name={`blog-card-${post.id}`}>
  <h2 class="list-title">
    <a
      href={`/blog/${post.id}/`}
      class="link-text"
      transition:name={`blog-title-${post.id}`}
    >
      {post.data.title}
    </a>
  </h2>
  <div class="item-meta">
    <time datetime={post.data.published_at.toISOString()}>
      {post.data.published_at.toLocaleDateString("ja-JP")}
    </time>
    {post.data.topics.toSorted().map((tag: string) => (
      <Tag
        label={tag}
        href={`/tags/${slugifyTag(tag)}`}
        active={isActiveTag(tag)}
      />
    ))}
    {post.data.zenn_slug && (
      <a
        href={`https://zenn.dev/hal227/articles/${post.data.zenn_slug}`}
        class="link-text inline-flex min-h-6 ml-auto items-center text-muted hover:text-ink"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Read ${post.data.title} on Zenn`}
      >
        –– Published on Zenn
      </a>
    )}
  </div>
</article>
