---
import type { CollectionEntry } from "astro:content";
import { css } from "styled-system/css";
import Tag from "./Tag.astro";
import { slugifyTag } from "../../lib/tag";
import { itemMeta, linkText, listTitle } from "../../styles/ui";

const card = css({ py: "4" });
const zennLink = css({
  display: "inline-flex",
  minH: "6",
  alignItems: "center",
  marginInlineStart: "auto",
  color: "muted",
  _hover: { color: "ink" },
});

interface Props {
  post: CollectionEntry<"blog">;
  activeTag?: string | null;
}

const { post, activeTag = null } = Astro.props;

const isActiveTag = (tag: string) => activeTag === slugifyTag(tag);
---

<article class={card}>
  <h2 class={listTitle}>
    <a href={`/blog/${post.id}/`} class={linkText}>
      {post.data.title}
    </a>
  </h2>
  <div class={itemMeta}>
    <time datetime={post.data.published_at.toISOString()}>
      {post.data.published_at.toLocaleDateString("ja-JP")}
    </time>
    {post.data.topics.toSorted().map((tag: string) => (
      <Tag
        label={tag}
        href={`/tags/${slugifyTag(tag)}/`}
        active={isActiveTag(tag)}
      />
    ))}
    {post.data.zenn_slug && (
      <a
        href={`https://zenn.dev/hal227/articles/${post.data.zenn_slug}`}
        class:list={[linkText, zennLink]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Read ${post.data.title} on Zenn`}
      >
        — Published on Zenn
      </a>
    )}
  </div>
</article>
