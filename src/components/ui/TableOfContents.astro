---
import type { MarkdownHeading } from "astro";
import { css } from "styled-system/css";
import { linkText } from "../../styles/ui";

const nav = css({ mt: "3" });
const list = css({
  display: "flex",
  flexDirection: "column",
  gap: "1",
  fontSize: "sm",
  lineHeight: "1.25rem",
});
const item = css({ py: "1" });
const nested = css({ py: "1", ps: "4" });
const link = css({
  lineHeight: "relaxed",
  overflowWrap: "anywhere",
  color: "ink",
});
const nestedLink = css({
  lineHeight: "relaxed",
  overflowWrap: "anywhere",
  color: "muted",
  _hover: { color: "ink" },
});

interface Props {
  headings: MarkdownHeading[];
}

// 目次に表示する見出しレベル
const TOC_HEADING_LEVEL_2 = 2;
const TOC_HEADING_LEVEL_3 = 3;

const { headings } = Astro.props;
// 下線は要素の箱に付く。block や inline-block にすると、折り返した各行ではなく箱の下に線が出る。
const tocHeadings = headings.filter(
  (h) => h.depth === TOC_HEADING_LEVEL_2 || h.depth === TOC_HEADING_LEVEL_3,
);
---

<nav aria-label="目次" class={nav}>
  <ul class={list}>
    {tocHeadings.map((heading) => (
      <li class={heading.depth === TOC_HEADING_LEVEL_3 ? nested : item}>
        <a
          href={`#${heading.slug}`}
          class:list={[
            linkText,
            heading.depth === TOC_HEADING_LEVEL_3 ? nestedLink : link,
          ]}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
