---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// 目次に表示する見出しレベル
const TOC_HEADING_LEVEL_2 = 2;
const TOC_HEADING_LEVEL_3 = 3;

const { headings } = Astro.props;
// H2 と h3 のみを抽出
const tocHeadings = headings.filter(
  (h) => h.depth === TOC_HEADING_LEVEL_2 || h.depth === TOC_HEADING_LEVEL_3,
);
---

<nav aria-label="目次" class="mt-3">
  <ul class="flex flex-col gap-1 text-sm">
    {tocHeadings.map((heading) => (
      <li class={heading.depth === TOC_HEADING_LEVEL_3 ? "pl-4" : undefined}>
        <a
          href={`#${heading.slug}`}
          class="link-text block py-1 leading-relaxed text-muted hover:text-ink [overflow-wrap:anywhere]"
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
