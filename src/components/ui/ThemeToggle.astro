---
import { css } from "../../../styled-system/css";
import Icon from "./Icon.astro";
import {
  focused,
  srOnly,
  themeCheck,
  themeIcon,
  themeOption,
  themeOptionCopy,
} from "../../styles/ui";

const picker = css({
  position: "relative",
  display: "flex",
  flexShrink: "0",
  alignItems: "center",
  color: "ink",
});
const trigger = css({
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  minH: "10",
  minW: "10",
  color: "muted",
  _hover: { color: "ink" },
});
const panel = css({
  position: "absolute",
  top: "100%",
  mt: "2",
  insetInlineEnd: "0",
  zIndex: "20",
  w: "10.5rem",
  maxW: "calc(100vw - 2rem)",
  p: "1",
  borderWidth: "1px",
  borderStyle: "solid",
  borderColor: "line",
  borderRadius: "lg",
  bg: "surface",
  boxShadow: "popup",
  "&[hidden]": { display: "none" },
});
const tight = css({ lineHeight: "tight" });
---

<div class={picker} data-theme-picker>
  <button
    type="button"
    class:list={[trigger, focused]}
    id="theme-trigger"
    aria-label="カラーテーマ: auto"
    aria-expanded="false"
    aria-controls="theme-options"
    data-theme-trigger
  >
    <span
      class="t-icon-swap"
      data-state="auto"
      data-theme-icon
      aria-hidden="true"
    >
      <Icon
        name="monitor"
        class:list={["theme-icon", themeIcon]}
        marker="auto"
      />
      <Icon name="sun" class:list={["theme-icon", themeIcon]} marker="light" />
      <Icon name="moon" class:list={["theme-icon", themeIcon]} marker="dark" />
    </span>
    <span class={css({ display: "none" })} data-theme-label>
      auto
    </span>
  </button>
  <fieldset
    class:list={["t-dropdown", panel]}
    id="theme-options"
    aria-label="カラーテーマ"
    data-theme-panel
    hidden
  >
    <label class={themeOption}>
      <input
        class:list={["peer", srOnly]}
        type="radio"
        name="color-theme"
        value="auto"
        data-theme-option
        checked
      />
      <Icon name="monitor" class:list={["theme-icon", themeIcon]} />
      <span class={themeOptionCopy}>
        <span class={tight}>auto</span>
      </span>
      <Icon name="check" class={themeCheck} />
    </label>
    <label class={themeOption}>
      <input
        class:list={["peer", srOnly]}
        type="radio"
        name="color-theme"
        value="light"
        data-theme-option
      />
      <Icon name="sun" class:list={["theme-icon", themeIcon]} />
      <span class={themeOptionCopy}>
        <span class={tight}>light</span>
      </span>
      <Icon name="check" class={themeCheck} />
    </label>
    <label class={themeOption}>
      <input
        class:list={["peer", srOnly]}
        type="radio"
        name="color-theme"
        value="dark"
        data-theme-option
      />
      <Icon name="moon" class:list={["theme-icon", themeIcon]} />
      <span class={themeOptionCopy}>
        <span class={tight}>dark</span>
      </span>
      <Icon name="check" class={themeCheck} />
    </label>
  </fieldset>
</div>
<p
  role="status"
  aria-live="polite"
  aria-atomic="true"
  class={srOnly}
  data-theme-status
></p>

<script>
  const themes = ["auto", "light", "dark"] as const;
  type Theme = (typeof themes)[number];
  const isTheme = (value: string | null | undefined): value is Theme =>
    themes.includes(value as Theme);
  const labels: Record<Theme, string> = {
    auto: "auto",
    light: "light",
    dark: "dark",
  };

  const media = window.matchMedia("(prefers-color-scheme: dark)");
  let theme: Theme = isTheme(document.documentElement.dataset.theme)
    ? document.documentElement.dataset.theme
    : "auto";

  const applyTheme = (next: Theme) => {
    theme = next;
    const root = document.documentElement;
    root.dataset.theme = theme;
    root.classList.toggle(
      "dark",
      theme === "dark" || (theme === "auto" && media.matches),
    );
  };

  const closeTimers = new WeakMap<HTMLElement, number>();
  const closePicker = (picker: HTMLElement, returnFocus = false) => {
    const trigger = picker.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
    if (!trigger || !panel) return;
    const timer = closeTimers.get(panel);
    if (timer !== undefined) window.clearTimeout(timer);
    closeTimers.delete(panel);
    if (!panel.hidden) {
      panel.inert = true;
      panel.setAttribute("aria-hidden", "true");
      panel.classList.remove("is-open");
      panel.classList.add("is-closing");
      trigger.setAttribute("aria-expanded", "false");
      const duration = window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches
        ? 0
        : Number.parseFloat(
            getComputedStyle(panel).getPropertyValue("--dropdown-close-dur"),
          ) || 150;
      const closeTimer = window.setTimeout(() => {
        panel.classList.remove("is-closing");
        panel.hidden = true;
        panel.removeAttribute("aria-hidden");
        closeTimers.delete(panel);
      }, duration);
      closeTimers.set(panel, closeTimer);
    }
    if (returnFocus) trigger.focus();
  };

  const openPicker = (picker: HTMLElement) => {
    const trigger = picker.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
    if (!trigger || !panel) return;
    const timer = closeTimers.get(panel);
    if (timer !== undefined) window.clearTimeout(timer);
    closeTimers.delete(panel);
    panel.hidden = false;
    panel.inert = false;
    panel.removeAttribute("aria-hidden");
    panel.classList.remove("is-closing");
    void panel.offsetHeight;
    panel.classList.add("is-open");
    trigger.setAttribute("aria-expanded", "true");
  };

  const syncSelection = () => {
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        const active = isTheme(theme) ? theme : "auto";
        picker
          .querySelectorAll<HTMLInputElement>("[data-theme-option]")
          .forEach((input) => {
            input.checked = input.value === active;
          });
        const label = picker.querySelector<HTMLElement>("[data-theme-label]");
        if (label) label.textContent = labels[active];
        const trigger = picker.querySelector<HTMLButtonElement>(
          "[data-theme-trigger]",
        );
        if (trigger) {
          trigger.setAttribute("aria-label", `カラーテーマ: ${labels[active]}`);
          picker
            .querySelectorAll<HTMLElement>("[data-theme-icon]")
            .forEach((icon) => {
              icon.dataset.state = active;
            });
        }
      });
  };

  let themeTransitionTimer: number | undefined;
  const stopThemeTransition = () => {
    window.clearTimeout(themeTransitionTimer);
    themeTransitionTimer = undefined;
    delete document.documentElement.dataset.themeTransition;
  };
  const changeTheme = (next: Theme) => {
    window.clearTimeout(themeTransitionTimer);
    const root = document.documentElement;
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.dataset.themeTransition = "";
      // Commit the current palette before changing its transition target.
      getComputedStyle(root).getPropertyValue("--color-canvas");
      themeTransitionTimer = window.setTimeout(stopThemeTransition, 350);
    } else {
      stopThemeTransition();
    }
    applyTheme(next);
    syncSelection();
  };

  document.addEventListener("astro:before-preparation", stopThemeTransition);

  const readStoredTheme = (): Theme | null => {
    try {
      const stored = localStorage.getItem("theme");
      return isTheme(stored) ? stored : null;
    } catch {
      return null;
    }
  };

  const initialTheme = readStoredTheme();
  if (initialTheme) applyTheme(initialTheme);
  syncSelection();

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLButtonElement>("[data-theme-trigger]");
    if (!trigger) return;
    const picker = trigger.closest<HTMLElement>("[data-theme-picker]");
    const panel = picker?.querySelector<HTMLElement>("[data-theme-panel]");
    if (!picker || !panel) return;
    const opening = panel.hidden || panel.classList.contains("is-closing");
    if (opening) openPicker(picker);
    else closePicker(picker);
    if (opening && event.detail === 0) {
      picker
        .querySelector<HTMLInputElement>("[data-theme-option]:checked")
        ?.focus();
    }
  });

  document.addEventListener("change", (event) => {
    const input = event.target;
    if (
      !(input instanceof HTMLInputElement) ||
      !input.matches("[data-theme-option]")
    )
      return;
    if (!isTheme(input.value)) {
      syncSelection();
      return;
    }
    changeTheme(input.value);
    try {
      localStorage.setItem("theme", input.value);
    } catch {
      // Keep the in-memory choice active when storage is unavailable.
    }
    syncSelection();
    const status = document.querySelector<HTMLElement>("[data-theme-status]");
    if (status)
      status.textContent = `テーマを${labels[input.value]}に変更しました`;
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const picker = target.closest<HTMLElement>("[data-theme-picker]");
    if (event.key === "Escape" && picker) {
      const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
      if (panel && !panel.hidden) {
        event.preventDefault();
        closePicker(picker, true);
      }
      return;
    }
    if (event.key !== "ArrowDown" || !target.matches("[data-theme-trigger]"))
      return;
    const panel = picker?.querySelector<HTMLElement>("[data-theme-panel]");
    if (!picker || !panel) return;
    openPicker(picker);
    picker
      .querySelector<HTMLInputElement>("[data-theme-option]:checked")
      ?.focus();
    event.preventDefault();
  });

  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Node)) return;
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        if (!picker.contains(event.target as Node)) closePicker(picker);
      });
  });

  document.addEventListener("focusout", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const picker = target.closest<HTMLElement>("[data-theme-picker]");
    if (
      picker &&
      event.relatedTarget instanceof Node &&
      !picker.contains(event.relatedTarget)
    ) {
      closePicker(picker);
    }
  });

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        closePicker(picker);
      });
    syncSelection();
  });
  document.addEventListener("astro:before-swap", (event) => {
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
        const trigger = picker.querySelector<HTMLButtonElement>(
          "[data-theme-trigger]",
        );
        if (!panel) return;
        const timer = closeTimers.get(panel);
        if (timer !== undefined) window.clearTimeout(timer);
        closeTimers.delete(panel);
        panel.classList.remove("is-open", "is-closing");
        panel.hidden = true;
        panel.inert = false;
        panel.removeAttribute("aria-hidden");
        trigger?.setAttribute("aria-expanded", "false");
      });
    event.newDocument.documentElement.dataset.theme = theme;
    event.newDocument.documentElement.classList.toggle(
      "dark",
      theme === "dark" || (theme === "auto" && media.matches),
    );
  });
  media.addEventListener("change", () => {
    if (theme === "auto") changeTheme("auto");
  });
  window.addEventListener("storage", (event) => {
    if (event.key !== "theme") return;
    const stored = isTheme(event.newValue) ? event.newValue : "auto";
    changeTheme(stored);
    syncSelection();
  });
</script>
