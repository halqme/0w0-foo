---
import { css } from "styled-system/css";
import Icon from "./Icon.astro";
import {
  focused,
  srOnly,
  themeCheck,
  themeIcon,
  themeOption,
  themeOptionCopy,
} from "../../styles/ui";

const picker = css({
  position: "relative",
  display: "flex",
  flexShrink: "0",
  alignItems: "center",
  color: "ink",
});
const trigger = css({
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  minH: "10",
  minW: "10",
  color: "muted",
  WebkitTapHighlightColor: "transparent",
  _hover: { color: "ink" },
  _motionSafe: {
    transitionProperty: "scale",
    transitionDuration: "fast",
    transitionTimingFunction: "ease-out",
    "&:not(:disabled):active": { scale: "0.96" },
  },
});
const iconSwap = css({
  "--icon-swap-dur": "token(durations.slow)",
  "--icon-swap-blur": "4px",
  "--icon-swap-start-scale": "0.25",
  position: "relative",
  display: "inline-grid",
  w: "4",
  h: "4",
  flex: "none",
  "& [data-icon]": {
    gridArea: "1 / 1",
    display: "block",
    _motionSafe: {
      transitionProperty: "opacity, filter, transform",
      transitionDuration: "var(--icon-swap-dur)",
      transitionTimingFunction: "settle",
    },
    _motionReduce: {
      transition: "none!",
      transform: "none!",
      filter: "none!",
    },
  },
  '&[data-state="auto"] [data-icon="auto"], &[data-state="light"] [data-icon="light"], &[data-state="dark"] [data-icon="dark"]':
    {
      opacity: "1",
      filter: "blur(0)",
      transform: "scale(1)",
    },
  '&[data-state="auto"] [data-icon]:not([data-icon="auto"]), &[data-state="light"] [data-icon]:not([data-icon="light"]), &[data-state="dark"] [data-icon]:not([data-icon="dark"])':
    {
      opacity: "0",
      filter: "blur(var(--icon-swap-blur))",
      transform: "scale(var(--icon-swap-start-scale))",
    },
});
const panel = css({
  "--dropdown-open-dur": "token(durations.slow)",
  "--dropdown-close-dur": "token(durations.fast)",
  position: "absolute",
  top: "100%",
  mt: "2",
  insetInlineEnd: "0",
  zIndex: "20",
  w: "10.5rem",
  maxW: "calc(100vw - 2rem)",
  p: "1",
  borderWidth: "1px",
  borderStyle: "solid",
  borderColor: "line",
  borderRadius: "lg",
  bg: "surface",
  boxShadow: "popup",
  transform: "translateY(-8px) scale(0.96)",
  transformOrigin: "top right",
  opacity: "0",
  pointerEvents: "none",
  _motionSafe: {
    transitionProperty: "transform, opacity",
    transitionDuration: "var(--dropdown-open-dur)",
    transitionTimingFunction: "settle",
  },
  "&.is-open": {
    transform: "scale(1)",
    opacity: "1",
    pointerEvents: "auto",
  },
  "&.is-closing": {
    transform: "translateY(-8px) scale(0.96)",
    opacity: "0",
    pointerEvents: "none",
    _motionSafe: { transitionDuration: "var(--dropdown-close-dur)" },
  },
  _motionReduce: {
    transition: "none!",
    transform: "none!",
    "&.is-open, &.is-closing": { transform: "none!" },
  },
  "&[hidden]": { display: "none" },
});
const tight = css({ lineHeight: "tight" });
---

<div class={picker} data-theme-picker>
  <button
    type="button"
    class:list={[trigger, focused]}
    id="theme-trigger"
    aria-label="カラーテーマ: auto"
    aria-expanded="false"
    aria-controls="theme-options"
    data-theme-trigger
  >
    <span class={iconSwap} data-state="auto" data-theme-icon aria-hidden="true">
      <Icon name="monitor" class={themeIcon} marker="auto" />
      <Icon name="sun" class={themeIcon} marker="light" />
      <Icon name="moon" class={themeIcon} marker="dark" />
    </span>
    <span class={css({ display: "none" })} data-theme-label>
      auto
    </span>
  </button>
  <fieldset
    class={panel}
    id="theme-options"
    aria-label="カラーテーマ"
    data-theme-panel
    hidden
  >
    <label class={themeOption}>
      <input
        class:list={["peer", srOnly]}
        type="radio"
        name="color-theme"
        value="auto"
        data-theme-option
        checked
      />
      <Icon name="monitor" class={themeIcon} />
      <span class={themeOptionCopy}>
        <span class={tight}>auto</span>
      </span>
      <Icon name="check" class={themeCheck} />
    </label>
    <label class={themeOption}>
      <input
        class:list={["peer", srOnly]}
        type="radio"
        name="color-theme"
        value="light"
        data-theme-option
      />
      <Icon name="sun" class={themeIcon} />
      <span class={themeOptionCopy}>
        <span class={tight}>light</span>
      </span>
      <Icon name="check" class={themeCheck} />
    </label>
    <label class={themeOption}>
      <input
        class:list={["peer", srOnly]}
        type="radio"
        name="color-theme"
        value="dark"
        data-theme-option
      />
      <Icon name="moon" class={themeIcon} />
      <span class={themeOptionCopy}>
        <span class={tight}>dark</span>
      </span>
      <Icon name="check" class={themeCheck} />
    </label>
  </fieldset>
</div>
<p
  role="status"
  aria-live="polite"
  aria-atomic="true"
  class={srOnly}
  data-theme-status
></p>

<script>
  import {
    themeFadeColors,
    themeFadeEase,
    themeFadeTimeAt,
    themeFadeVariables,
  } from "../../styles/theme-fade";

  const themes = ["auto", "light", "dark"] as const;
  type Theme = (typeof themes)[number];
  const isTheme = (value: string | null | undefined): value is Theme =>
    themes.includes(value as Theme);
  const labels: Record<Theme, string> = {
    auto: "auto",
    light: "light",
    dark: "dark",
  };

  const media = window.matchMedia("(prefers-color-scheme: dark)");
  let theme: Theme = isTheme(document.documentElement.dataset.theme)
    ? document.documentElement.dataset.theme
    : "auto";

  const applyTheme = (next: Theme) => {
    theme = next;
    const root = document.documentElement;
    root.dataset.theme = theme;
    root.classList.toggle(
      "dark",
      theme === "dark" || (theme === "auto" && media.matches),
    );
  };

  const closeTimers = new WeakMap<HTMLElement, number>();
  const closePicker = (picker: HTMLElement, returnFocus = false) => {
    const trigger = picker.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
    if (!trigger || !panel) return;
    const timer = closeTimers.get(panel);
    if (timer !== undefined) window.clearTimeout(timer);
    closeTimers.delete(panel);
    if (!panel.hidden) {
      panel.inert = true;
      panel.setAttribute("aria-hidden", "true");
      panel.classList.remove("is-open");
      panel.classList.add("is-closing");
      trigger.setAttribute("aria-expanded", "false");
      const duration = window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches
        ? 0
        : Number.parseFloat(
            getComputedStyle(panel).getPropertyValue("--dropdown-close-dur"),
          ) || 150;
      const closeTimer = window.setTimeout(() => {
        panel.classList.remove("is-closing");
        panel.hidden = true;
        panel.removeAttribute("aria-hidden");
        closeTimers.delete(panel);
      }, duration);
      closeTimers.set(panel, closeTimer);
    }
    if (returnFocus) trigger.focus();
  };

  const openPicker = (picker: HTMLElement) => {
    const trigger = picker.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
    if (!trigger || !panel) return;
    const timer = closeTimers.get(panel);
    if (timer !== undefined) window.clearTimeout(timer);
    closeTimers.delete(panel);
    panel.hidden = false;
    panel.inert = false;
    panel.removeAttribute("aria-hidden");
    panel.classList.remove("is-closing");
    void panel.offsetHeight;
    panel.classList.add("is-open");
    trigger.setAttribute("aria-expanded", "true");
  };

  const syncSelection = () => {
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        const active = isTheme(theme) ? theme : "auto";
        picker
          .querySelectorAll<HTMLInputElement>("[data-theme-option]")
          .forEach((input) => {
            input.checked = input.value === active;
          });
        const label = picker.querySelector<HTMLElement>("[data-theme-label]");
        if (label) label.textContent = labels[active];
        const trigger = picker.querySelector<HTMLButtonElement>(
          "[data-theme-trigger]",
        );
        if (trigger) {
          trigger.setAttribute("aria-label", `カラーテーマ: ${labels[active]}`);
          picker
            .querySelectorAll<HTMLElement>("[data-theme-icon]")
            .forEach((icon) => {
              icon.dataset.state = active;
            });
        }
      });
  };

  // The fade runs here rather than as a CSS animation: each frame sets every
  // palette variable on the root. After a client-side navigation, Chrome loses
  // animated custom properties inside visited links, so their text would show
  // the link's color until the animation ends. Positions run from light (0) to
  // dark (1).
  const fadeNames = themeFadeColors.map((color) => `--${color.name}`);
  let fade: { frame: number; position: number } | undefined;
  const stopThemeTransition = () => {
    if (!fade) return;
    cancelAnimationFrame(fade.frame);
    fade = undefined;
    const style = document.documentElement.style;
    for (const name of fadeNames) style.removeProperty(name);
  };
  const startThemeTransition = (dark: boolean, from: number) => {
    const root = document.documentElement;
    const slow = getComputedStyle(root)
      .getPropertyValue("--durations-slow")
      .trim();
    const duration =
      Number.parseFloat(slow) * (slow.endsWith("ms") ? 1 : 1000) || 300;
    // A switch that reverses partway continues from where the colors are.
    const start =
      performance.now() - themeFadeTimeAt(dark ? from : 1 - from) * duration;
    const step = () => {
      const time = Math.min(1, (performance.now() - start) / duration);
      if (time === 1) {
        stopThemeTransition();
        return;
      }
      const eased = themeFadeEase(time);
      const position = dark ? eased : 1 - eased;
      for (const [name, value] of themeFadeVariables(position)) {
        root.style.setProperty(name, value);
      }
      fade = { frame: requestAnimationFrame(step), position };
    };
    step();
  };
  const changeTheme = (next: Theme) => {
    const root = document.documentElement;
    const wasDark = root.classList.contains("dark");
    const position = fade?.position ?? (wasDark ? 1 : 0);
    applyTheme(next);
    syncSelection();
    const dark = root.classList.contains("dark");
    // A fade already heading to the same mode keeps running.
    if (dark === wasDark) return;
    stopThemeTransition();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    startThemeTransition(dark, position);
  };

  document.addEventListener("astro:before-preparation", stopThemeTransition);

  const readStoredTheme = (): Theme | null => {
    try {
      const stored = localStorage.getItem("theme");
      return isTheme(stored) ? stored : null;
    } catch {
      return null;
    }
  };

  const initialTheme = readStoredTheme();
  if (initialTheme) applyTheme(initialTheme);
  syncSelection();

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLButtonElement>("[data-theme-trigger]");
    if (!trigger) return;
    const picker = trigger.closest<HTMLElement>("[data-theme-picker]");
    const panel = picker?.querySelector<HTMLElement>("[data-theme-panel]");
    if (!picker || !panel) return;
    const opening = panel.hidden || panel.classList.contains("is-closing");
    if (opening) openPicker(picker);
    else closePicker(picker);
    if (opening && event.detail === 0) {
      picker
        .querySelector<HTMLInputElement>("[data-theme-option]:checked")
        ?.focus();
    }
  });

  document.addEventListener("change", (event) => {
    const input = event.target;
    if (
      !(input instanceof HTMLInputElement) ||
      !input.matches("[data-theme-option]")
    )
      return;
    if (!isTheme(input.value)) {
      syncSelection();
      return;
    }
    changeTheme(input.value);
    try {
      localStorage.setItem("theme", input.value);
    } catch {
      // Keep the in-memory choice active when storage is unavailable.
    }
    syncSelection();
    const status = document.querySelector<HTMLElement>("[data-theme-status]");
    if (status)
      status.textContent = `テーマを${labels[input.value]}に変更しました`;
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const picker = target.closest<HTMLElement>("[data-theme-picker]");
    if (event.key === "Escape" && picker) {
      const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
      if (panel && !panel.hidden) {
        event.preventDefault();
        closePicker(picker, true);
      }
      return;
    }
    if (event.key !== "ArrowDown" || !target.matches("[data-theme-trigger]"))
      return;
    const panel = picker?.querySelector<HTMLElement>("[data-theme-panel]");
    if (!picker || !panel) return;
    openPicker(picker);
    picker
      .querySelector<HTMLInputElement>("[data-theme-option]:checked")
      ?.focus();
    event.preventDefault();
  });

  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Node)) return;
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        if (!picker.contains(event.target as Node)) closePicker(picker);
      });
  });

  document.addEventListener("focusout", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const picker = target.closest<HTMLElement>("[data-theme-picker]");
    if (
      picker &&
      event.relatedTarget instanceof Node &&
      !picker.contains(event.relatedTarget)
    ) {
      closePicker(picker);
    }
  });

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        closePicker(picker);
      });
    syncSelection();
  });
  document.addEventListener("astro:before-swap", (event) => {
    document
      .querySelectorAll<HTMLElement>("[data-theme-picker]")
      .forEach((picker) => {
        const panel = picker.querySelector<HTMLElement>("[data-theme-panel]");
        const trigger = picker.querySelector<HTMLButtonElement>(
          "[data-theme-trigger]",
        );
        if (!panel) return;
        const timer = closeTimers.get(panel);
        if (timer !== undefined) window.clearTimeout(timer);
        closeTimers.delete(panel);
        panel.classList.remove("is-open", "is-closing");
        panel.hidden = true;
        panel.inert = false;
        panel.removeAttribute("aria-hidden");
        trigger?.setAttribute("aria-expanded", "false");
      });
    event.newDocument.documentElement.dataset.theme = theme;
    event.newDocument.documentElement.classList.toggle(
      "dark",
      theme === "dark" || (theme === "auto" && media.matches),
    );
  });
  media.addEventListener("change", () => {
    if (theme === "auto") changeTheme("auto");
  });
  window.addEventListener("storage", (event) => {
    if (event.key !== "theme") return;
    const stored = isTheme(event.newValue) ? event.newValue : "auto";
    changeTheme(stored);
    syncSelection();
  });
</script>
