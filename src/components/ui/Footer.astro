---
import Socials from "./Socials.astro";

const today = new Date();
---

<footer class="container-main mt-auto text-center pt-10 pb-12 sm:pb-16">
  <div class="border-t border-line pt-6">
    <div class="mb-4 flex flex-wrap justify-center gap-x-5">
      <Socials />
    </div>
    <p class="text-xs text-muted">
      &copy; {today.getFullYear()} HALQME. All rights reserved.
    </p>
  </div>
</footer>
