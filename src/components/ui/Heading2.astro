---
import { css } from "../../../styled-system/css";

interface Props {
  title: string;
  id?: string;
}
const {
  title,
  id = `${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-title`,
} = Astro.props;
---

<h2
  id={id}
  class={css({
    mb: "6",
    fontFamily: "emphasis",
    fontSize: "xl",
    fontWeight: "bold",
    lineHeight: "snug",
    color: "ink",
    textWrap: "balance",
  })}
>
  {title}
</h2>
