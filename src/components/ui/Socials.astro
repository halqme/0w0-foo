---
import { link } from "styled-system/recipes";

const socialLinks: { ariaLabel: string; href: string; name: string }[] = [
  {
    ariaLabel: "GitHubプロフィール",
    href: "https://github.com/halqme",
    name: "GitHub",
  },
  {
    ariaLabel: "Twitterプロフィール",
    href: "https://twitter.com/halqme_dev",
    name: "Twitter",
  },
  {
    ariaLabel: "Zennプロフィール",
    href: "https://zenn.dev/hal227",
    name: "Zenn",
  },
  {
    ariaLabel: "/dev/nullプロフィール",
    href: "https://dev-null.sh/@halqme",
    name: "/dev/null",
  },
];
---

{socialLinks.map((item) => (
  <a
    href={item.href}
    target="_blank"
    rel="noopener noreferrer"
    class={link({ kind: "action" })}
    aria-label={item.ariaLabel}
  >
    {item.name}
  </a>
))}
