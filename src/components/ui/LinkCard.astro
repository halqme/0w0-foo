---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getLinkCardData, linkCardClasses } from "../../lib/link-card";

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const { image } = getLinkCardData(href);
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/.astro/link-card-images/*",
);
const source = image ? (await images[image]?.())?.default : undefined;
---

{source && (
  <div class:list={["flex flex-col overflow-hidden", className]}>
    <span class={linkCardClasses.imageContainer}>
      <Image
        src={source}
        width={1200}
        height={630}
        alt=""
        class={linkCardClasses.image}
        loading="eager"
      />
    </span>
  </div>
)}
