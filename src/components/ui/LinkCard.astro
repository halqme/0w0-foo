---
import { css } from "styled-system/css";
import { getLinkCardPreview } from "../../lib/link-card-build";
import { linkCardClasses } from "../../lib/link-card";
import { focused, linkText } from "../../styles/ui";

const anchor = css({
  position: "relative",
  minW: "0",
  minH: "10",
});
const labelLink = css({
  textAlign: "start",
  fontSize: "sm",
  lineHeight: "1.25rem",
  color: "ink",
  overflowWrap: "break-word",
});
const panel = css({
  position: "absolute",
  insetInlineStart: "100%",
  top: "50%",
  marginInlineStart: "3",
  zIndex: "10",
  w: "80",
  maxW: "calc(100vw - 3rem)",
  transform: "translateY(-50%)",
});
const card = css({
  maxH: "60dvh",
  overflowY: "auto",
  overscrollBehavior: "contain",
  borderRadius: "md",
  borderWidth: "1px",
  borderStyle: "solid",
  borderColor: "line",
  bg: "surface",
  color: "ink",
  boxShadow: "popup",
});
const commentList = css({
  display: "grid",
  gap: "1",
  p: "2",
  fontSize: "sm",
  lineHeight: "1.75rem",
});

interface Props {
  href: string;
  id: string;
  label: string;
  comments?: string[];
}

const { href, id, label, comments = [] } = Astro.props;
const source = await getLinkCardPreview(href);
const hasPreview = Boolean(source) || comments.length > 0;
---

<div class:list={["link-preview", anchor]}>
  <a
    {id}
    {href}
    class:list={[linkText, focused, labelLink]}
    aria-describedby={comments.length > 0 ? `${id}-preview` : undefined}
    target="_blank"
    rel="noopener noreferrer"
  >
    {label}
  </a>
  {hasPreview && (
    <div
      id={`${id}-preview`}
      role={comments.length > 0 ? "tooltip" : undefined}
      aria-hidden={comments.length === 0 ? "true" : undefined}
      class:list={["preview", panel]}
    >
      <div class={card}>
        {source && (
          <span class={linkCardClasses.imageContainer}>
            <img
              src={source}
              width={1200}
              height={630}
              alt=""
              class={linkCardClasses.image}
              loading="lazy"
            />
          </span>
        )}
        {comments.length > 0 && (
          <div class={commentList}>
            {comments.map((comment) => (
              <p>{comment}</p>
            ))}
          </div>
        )}
      </div>
    </div>
  )}
</div>

<style>
  .preview {
    display: none;
  }

  @media (width < 40rem) {
    .preview {
      position: static;
      inset: auto;
      margin: 0.5rem 0 0;
      width: 100%;
      max-width: 100%;
      transform: none;
    }
  }

  .link-preview:has(a:focus-visible) .preview {
    display: block;
  }

  @media (hover: hover) {
    .link-preview:has(a:hover, .preview:hover) .preview {
      display: block;
    }
  }
</style>
