<div
  class="mascot-root"
  data-mascot-root
  transition:persist="mascot"
  transition:name="mascot"
  transition:animate="none"
>
  <button
    class="mascot-motion-toggle"
    type="button"
    aria-label="マスコットの動き"
    aria-pressed="true"
    data-mascot-motion-toggle
    hidden
  >
    <span
      class="icon-sm i-lucide:pause"
      data-motion-pause
      aria-hidden="true"
    ></span>
    <span
      class="icon-sm i-lucide:play"
      data-motion-resume
      aria-hidden="true"
      hidden
    ></span>
  </button>
  <button
    class="mascot"
    type="button"
    aria-label="マスコットを喜ばせる"
    data-mascot
  >
    <span class="face-breath" data-face aria-hidden="true">
      0w0
    </span>
  </button>
  <span class="mascot mascot-follower" data-follower aria-hidden="true">
    <span class="face-breath" data-face>
      0w0
    </span>
  </span>
</div>

<style>
  .mascot {
    position: fixed;
    z-index: 20;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    width: 3.75rem;
    height: 2rem;
    place-items: center;
    padding: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-canvas) 80%, transparent);
    color: var(--color-accent);
    font-family: var(--font-ia-writer-mono), monospace;
    font-size: 1rem;
    line-height: 1;
    box-sizing: border-box;
  }
  button.mascot {
    cursor: pointer;
    touch-action: manipulation;
    pointer-events: auto;
  }
  .mascot-motion-toggle {
    position: fixed;
    z-index: 20;
    right: 5.75rem;
    bottom: 1.25rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-canvas) 80%, transparent);
    color: var(--color-accent);
    cursor: pointer;
    touch-action: manipulation;
    pointer-events: auto;
  }
  .mascot-motion-toggle[hidden],
  .mascot-motion-toggle [hidden] {
    display: none;
  }
  .mascot:focus-visible,
  .mascot-motion-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .mascot-root {
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }
  .mascot-follower {
    position: fixed;
    left: 0;
    top: 0;
    right: auto;
    bottom: auto;
    z-index: 21;
    visibility: hidden;
    pointer-events: none;
    will-change: transform;
  }
  .face-breath {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mascot-root[data-ready] .face-breath {
      animation: mascot-breathe 4.8s ease-in-out infinite;
    }
  }
  @keyframes mascot-breathe {
    0%,
    100% {
      translate: 0 0;
      scale: 1;
    }
    50% {
      translate: 0 -1.5px;
      scale: 1.025;
    }
  }
  .mascot-root[data-paused] .face-breath {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot-follower {
      will-change: auto;
    }
    .face-breath {
      animation: none;
      translate: none;
      scale: none;
    }
  }
</style>

<script>
  import {
    newTemperament,
    evolveTemperament,
    resolveIntent,
  } from "../../lib/mascot/behavior";
  import {
    chooseExpression,
    hoverFaceChoices,
  } from "../../lib/mascot/expression";
  import { mascotPose } from "../../lib/mascot/pose";
  import {
    advanceSleep,
    dispatchSleep,
    idleSleepRemaining,
    newSleepState,
    shiftSleepTime,
    storyRemaining,
  } from "../../lib/mascot/sleep";
  import {
    stepSteering,
    stepWander,
    newWander,
    sampleObstacles,
    intentTarget,
    retreatTarget,
    type Obstacle,
  } from "../../lib/mascot/steering";

  const clamp = (v: number, min: number, max: number) =>
    Math.max(min, Math.min(max, v));

  const choose = <T,>(items: T[], previous?: T) => {
    const choices = items.filter((item) => item !== previous);
    return choices[Math.floor(Math.random() * choices.length)] ?? items[0];
  };

  const bounds = () => ({
    minX: 22,
    maxX: Math.max(22, innerWidth - 92),
    minY: 48,
    maxY: Math.max(48, innerHeight - 66),
  });

  const initMascot = () => {
    const root = document.querySelector<HTMLElement>("[data-mascot-root]");
    const mascot = root?.querySelector<HTMLButtonElement>("[data-mascot]");
    const motionToggle = root?.querySelector<HTMLButtonElement>(
      "[data-mascot-motion-toggle]",
    );
    const face = mascot?.querySelector<HTMLElement>("[data-face]");
    const follower = root?.querySelector<HTMLElement>("[data-follower]");
    const followerFace = follower?.querySelector<HTMLElement>("[data-face]");
    if (
      !root ||
      !mascot ||
      !motionToggle ||
      !face ||
      !follower ||
      !followerFace ||
      mascot.dataset.ready
    )
      return;
    mascot.dataset.ready = "true";

    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const home = { x: 0, y: 0 };
    let target = { ...home },
      position = { ...home },
      velocity = { ...home };
    const temperament = newTemperament();
    let obstacles: Obstacle[] = [];
    let lastSample = -Infinity;
    let retreatGoal: { x: number; y: number } | null = null;
    let lastIntent = temperament.intent;
    let wander = newWander();
    let frame = 0,
      lastTime = 0;
    let pointer = { x: 0, y: 0, time: 0 },
      speed = 0;
    let following = false,
      paused = false,
      userPaused = false;
    const syncMotionToggle = () => {
      motionToggle.hidden = motion.matches;
      motionToggle.setAttribute("aria-pressed", String(!paused));
      const pauseIcon = motionToggle.querySelector<HTMLElement>(
        "[data-motion-pause]",
      );
      const resumeIcon = motionToggle.querySelector<HTMLElement>(
        "[data-motion-resume]",
      );
      if (pauseIcon) pauseIcon.hidden = paused;
      if (resumeIcon) resumeIcon.hidden = !paused;
    };
    syncMotionToggle();
    root.dataset.ready = "true";
    const sleep = newSleepState(performance.now());
    let happyUntil = 0,
      scrollUntil = 0,
      faceTimer = 0,
      idleTimer = 0,
      storyTimer = 0,
      pausedAt = 0;
    let hoverFace = "0ω0",
      scrollFace = "0o0",
      lastClickFace = "";
    let curious = false,
      pleased = false,
      hoveredInteractive: Element | null = null,
      hoveredAnchor: Element | null = null;
    const expressions = ["^w^", "0o0", "OwO", "0v0", "0ω0"];
    const setFace = (value: string) => {
      if (face.textContent !== value) face.textContent = value;
      if (followerFace.textContent !== value) followerFace.textContent = value;
    };
    function paintFace() {
      setFace(
        chooseExpression({
          now: performance.now(),
          happyUntil,
          clickFace: lastClickFace,
          scrollUntil,
          scrollFace,
          story: sleep.story,
          intent: temperament.intent,
          following,
          speed,
          curious,
          hoverFace,
          pleased,
        }),
      );
    }
    const armFaceExpiry = () => {
      clearTimeout(faceTimer);
      faceTimer = 0;
      const expiry = Math.max(happyUntil, scrollUntil);
      if (expiry <= performance.now()) return;
      faceTimer = window.setTimeout(() => {
        const now = performance.now();
        if (happyUntil <= now) happyUntil = 0;
        if (scrollUntil <= now) scrollUntil = 0;
        faceTimer = 0;
        paintFace();
        armFaceExpiry();
      }, expiry - performance.now());
    };

    const pointerTarget = (x: number, y: number) => {
      const b = bounds();
      return {
        x: clamp(
          x + Math.cos(wander.bearing) * wander.radius - 40,
          b.minX,
          b.maxX,
        ),
        y: clamp(
          y + Math.sin(wander.bearing) * wander.radius * 0.85 - 22,
          b.minY,
          b.maxY,
        ),
      };
    };
    const stop = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      lastTime = 0;
    };
    const clearIdle = () => {
      clearTimeout(idleTimer);
      idleTimer = 0;
    };
    const clearStoryTimer = () => {
      clearTimeout(storyTimer);
      storyTimer = 0;
    };
    const enterSleep = (event: Parameters<typeof dispatchSleep>[1]) => {
      const previous = sleep.story;
      if (!dispatchSleep(sleep, event, performance.now())) return false;
      if (sleep.story === previous) return false;
      armStory();
      return true;
    };
    const armStory = () => {
      clearStoryTimer();
      if (sleep.story !== "dozing" && sleep.story !== "dropping") return;
      storyTimer = window.setTimeout(
        () => {
          storyTimer = 0;
          // Do not retry a skipped completion: resume rearms after pause, and a missed fall must not play later on its own.
          if (
            paused ||
            motion.matches ||
            (sleep.story === "dozing" && !following)
          )
            return;
          if (enterSleep(sleep.story === "dozing" ? "DOZED" : "FELL"))
            paintFace();
        },
        storyRemaining(sleep, performance.now()),
      );
    };
    const armIdle = () => {
      clearIdle();
      idleTimer = window.setTimeout(
        () => {
          idleTimer = 0;
          if (paused) return;
          if (enterSleep(!following || motion.matches ? "REST" : "IDLE"))
            paintFace();
        },
        idleSleepRemaining(sleep, performance.now()),
      );
    };
    const activity = () => {
      if (!paused && document.visibilityState !== "hidden")
        delete root.dataset.paused;
      enterSleep("ACTIVITY");
      armIdle();
      paintFace();
      wake();
    };
    const render = (time: number) => {
      frame = 0;
      if (paused || motion.matches) return;
      const dt = Math.min((time - (lastTime || time)) / 1000, 0.05);
      lastTime = time;
      speed *= Math.exp(-6 * dt);
      if (following && sleep.story === "awake" && dt > 0)
        wander = stepWander(wander, dt);
      if (following) {
        evolveTemperament(temperament, dt, sleep.story === "awake");
        if (time - lastSample >= 380) {
          obstacles = sampleObstacles(root);
          lastSample = time;
        }
        const rect = hoveredInteractive?.getBoundingClientRect?.();
        const hoverRect =
          rect && Number.isFinite(rect.right)
            ? {
                left: rect.left,
                right: rect.right,
                top: rect.top,
                bottom: rect.bottom,
              }
            : null;
        const proximity = hoverRect
          ? Math.hypot(
              (hoverRect.left + hoverRect.right) / 2 - pointer.x,
              (hoverRect.top + hoverRect.bottom) / 2 - pointer.y,
            )
          : Infinity;
        resolveIntent(
          temperament,
          sleep.story === "awake",
          {
            pointerSpeed: speed,
            pointerDistance: Math.hypot(
              position.x + 40 - pointer.x,
              position.y + 22 - pointer.y,
            ),
            interactiveNearby: proximity < 360,
          },
          time,
        );
        if (temperament.intent !== lastIntent) {
          retreatGoal =
            temperament.intent === "retreat"
              ? retreatTarget(position, pointer)
              : null;
          lastIntent = temperament.intent;
        }
        target = intentTarget(
          temperament.intent,
          hoverRect,
          pointer,
          retreatGoal,
          pointerTarget(pointer.x, pointer.y),
        );
      }
      const bMotion = bounds();
      target = {
        x: clamp(target.x, bMotion.minX, bMotion.maxX),
        y: clamp(target.y, bMotion.minY, bMotion.maxY),
      };
      // Steering uses velocity and acceleration, rather than directly interpolating coordinates.
      const moved = stepSteering(
        { position, velocity },
        target,
        following ? obstacles : [],
        dt,
      );
      position = moved.position;
      velocity = moved.velocity;
      const recovered = advanceSleep(sleep, time, dt);
      if (recovered) enterSleep(recovered);
      const pose = mascotPose({
        time,
        position,
        target,
        pointer,
        bounds: bounds(),
        story: sleep.story,
        sleepOffset: sleep.offsetY,
        happyUntil,
        scrollUntil,
        following,
      });
      face.style.transform = `translateX(${pose.gaze}px)`;
      followerFace.style.transform = `translateX(${pose.gaze}px)`;
      follower.style.transform = `translate3d(${pose.follower.x}px, ${pose.follower.y}px, 0) rotate(${pose.tilt}deg)`;
      if (pose.home !== null)
        mascot.style.transform =
          pose.home === ""
            ? ""
            : `translate3d(${pose.home.x}px, ${pose.home.y}px, 0) rotate(${pose.home.rotation}deg)`;
      if (happyUntil && time >= happyUntil) happyUntil = 0;
      if (scrollUntil && time >= scrollUntil) scrollUntil = 0;
      paintFace();
      if (
        following ||
        happyUntil ||
        scrollUntil ||
        Math.abs(sleep.offsetY) > 0.1
      )
        frame = requestAnimationFrame(render);
      else lastTime = 0;
    };
    const wake = () => {
      if (!frame && !motion.matches && !paused)
        frame = requestAnimationFrame(render);
    };
    const reset = () => {
      stop();
      clearTimeout(faceTimer);
      faceTimer = 0;
      happyUntil = scrollUntil = 0;
      speed = 0;
      pointer = { x: 0, y: 0, time: 0 };
      clearIdle();
      clearStoryTimer();
      enterSleep("RESET");
      if (paused) root.dataset.paused = "true";
      else delete root.dataset.paused;
      velocity = { ...home };
      obstacles = [];
      lastSample = -Infinity;
      retreatGoal = null;
      Object.assign(temperament, newTemperament());
      lastIntent = temperament.intent;
      following = false;
      curious = pleased = false;
      hoveredInteractive = hoveredAnchor = null;
      mascot.style.visibility = "visible";
      mascot.style.transform = "";
      follower.style.visibility = "hidden";
      follower.style.transform = "";
      face.style.transform = followerFace.style.transform = "";
      setFace("0w0");
    };
    const onPointerMove = (event: PointerEvent) => {
      if (
        paused ||
        event.pointerType !== "mouse" ||
        document.activeElement === mascot
      )
        return;
      activity();
      if (motion.matches) return;
      const now = performance.now(),
        elapsed = now - pointer.time;
      if (pointer.time && elapsed > 0)
        speed =
          Math.hypot(event.clientX - pointer.x, event.clientY - pointer.y) /
          elapsed;
      pointer = { x: event.clientX, y: event.clientY, time: now };
      if (!following) {
        const rect = mascot.getBoundingClientRect();
        position = { x: rect.left, y: rect.top };
        velocity = { ...home };
        target = { ...position };
      }
      target = pointerTarget(event.clientX, event.clientY);
      following = true;
      mascot.style.visibility = "hidden";
      follower.style.visibility = "visible";
      wake();
    };
    const onPointerLeave = (event: PointerEvent) => {
      if (!paused && event.relatedTarget === null) reset();
    };
    const bounce = () => {
      if (paused) return;
      activity();
      lastClickFace = choose(expressions, lastClickFace);
      happyUntil = performance.now() + 700;
      armFaceExpiry();
      paintFace();
      wake();
    };
    const onFocus = () => {
      if (!paused) {
        if (following) reset();
        activity();
        pleased = true;
        paintFace();
      }
    };
    const onTargetEnter = (event: PointerEvent | FocusEvent) => {
      if (paused || !(event.target instanceof Element)) return;
      const element = event.target;
      if (mascot.contains(element)) {
        pleased = true;
        activity();
        paintFace();
        return;
      }
      const interactive = element.closest(
        'a, button, input, select, textarea, summary, [role="button"]',
      );
      if (!interactive || interactive === hoveredInteractive) return;
      hoveredInteractive = interactive;
      hoveredAnchor = interactive.closest("a");
      curious = true;
      let external = false;
      if (hoveredAnchor instanceof HTMLAnchorElement) {
        try {
          external =
            new URL(hoveredAnchor.href, document.baseURI).origin !==
            location.origin;
        } catch {
          external = true;
        }
      }
      hoverFace = choose(
        hoverFaceChoices(external, hoveredAnchor !== null),
        hoverFace,
      );
      activity();
      paintFace();
    };
    const onTargetLeave = (event: PointerEvent | FocusEvent) => {
      if (paused || !(event.target instanceof Element)) return;
      const element = event.target,
        related = event.relatedTarget;
      const interactive = element.closest(
        'a, button, input, select, textarea, summary, [role="button"]',
      );
      if (
        related instanceof Element &&
        (interactive?.contains(related) || mascot.contains(related))
      )
        return;
      if (interactive && interactive !== hoveredInteractive) return;
      if (mascot.contains(element))
        pleased =
          event.type === "focusout" && document.activeElement === mascot;
      else {
        hoveredInteractive = hoveredAnchor = null;
        curious = false;
      }
      paintFace();
    };
    const onScroll = () => {
      if (paused) return;
      activity();
      const now = performance.now();
      lastSample = -Infinity;
      if (now >= scrollUntil)
        scrollFace = choose(["0o0", "0v0", "OwO"], scrollFace);
      scrollUntil = now + 700;
      armFaceExpiry();
      paintFace();
      wake();
    };
    const pause = () => {
      if (paused) return;
      paused = true;
      syncMotionToggle();
      pausedAt = performance.now();
      root.dataset.paused = "true";
      stop();
      clearIdle();
      clearStoryTimer();
      clearTimeout(faceTimer);
      faceTimer = 0;
      hoveredInteractive = hoveredAnchor = null;
      curious = pleased = false;
    };
    const resume = () => {
      if (document.querySelector("[data-mascot-root]") !== root) {
        cleanup();
        return;
      }
      clearTimeout(faceTimer);
      faceTimer = 0;
      if (!paused) {
        clearIdle();
        return;
      }
      const duration = performance.now() - pausedAt;
      paused = false;
      syncMotionToggle();
      delete root.dataset.paused;
      happyUntil += happyUntil ? duration : 0;
      scrollUntil += scrollUntil ? duration : 0;
      clearIdle();
      shiftSleepTime(sleep, duration);
      armStory();
      if (sleep.story === "awake" && sleep.storyReady) armIdle();
      armFaceExpiry();
      if (!motion.matches && (following || happyUntil || scrollUntil)) wake();
    };
    const onMotionChange = () => {
      syncMotionToggle();
      if (motion.matches) {
        reset();
        if (!paused) activity();
      } else if (!paused) {
        activity();
      }
    };
    const onWindowBlur = () => {
      if (!paused) {
        reset();
        root.dataset.paused = "true";
      }
    };
    const onResize = () => {
      if (!paused && following) {
        target = pointerTarget(pointer.x, pointer.y);
        wake();
      }
    };
    const cleanup = () => {
      reset();
      document.removeEventListener("pointermove", onPointerMove);
      document.removeEventListener("pointerleave", onPointerLeave);
      document.removeEventListener("pointerdown", onPointerDown);
      document.removeEventListener("pointerover", onTargetEnter);
      document.removeEventListener("focusin", onTargetEnter);
      document.removeEventListener("pointerout", onTargetLeave);
      document.removeEventListener("focusout", onTargetLeave);
      document.removeEventListener("scroll", onScroll);
      document.removeEventListener("visibilitychange", onVisibilityChange);
      window.removeEventListener("blur", onWindowBlur);
      window.removeEventListener("resize", onResize);
      motion.removeEventListener("change", onMotionChange);
      mascot.removeEventListener("focus", onFocus);
      mascot.removeEventListener("click", bounce);
      motionToggle.removeEventListener("click", onMotionToggle);
      document.removeEventListener("astro:before-swap", onBeforeSwap);
      document.removeEventListener("astro:after-swap", onAfterSwap);
      document.removeEventListener("astro:page-load", onPageLoad);
      delete mascot.dataset.ready;
    };
    const onBeforeSwap = () => pause();
    const onAfterSwap = () => {
      if (document.querySelector("[data-mascot-root]") !== root) cleanup();
    };
    const onPageLoad = () => {
      if (!userPaused) resume();
    };
    const onVisibilityChange = () => {
      if (!paused && document.visibilityState === "hidden") {
        reset();
        root.dataset.paused = "true";
      } else if (!paused) delete root.dataset.paused;
    };
    const onMotionToggle = () => {
      if (userPaused) {
        userPaused = false;
        resume();
      } else {
        userPaused = true;
        pause();
      }
    };
    const onPointerDown = (event: PointerEvent) => {
      if (paused) return;
      // The button's own click handler already triggers bounce.
      if (event.target instanceof Element && mascot.contains(event.target))
        return;
      if (event.pointerType === "mouse") bounce();
      else activity();
    };
    document.addEventListener("pointermove", onPointerMove, { passive: true });
    document.addEventListener("pointerleave", onPointerLeave);
    document.addEventListener("pointerdown", onPointerDown);
    document.addEventListener("pointerover", onTargetEnter);
    document.addEventListener("focusin", onTargetEnter);
    document.addEventListener("pointerout", onTargetLeave);
    document.addEventListener("focusout", onTargetLeave);
    document.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("visibilitychange", onVisibilityChange);
    window.addEventListener("blur", onWindowBlur);
    window.addEventListener("resize", onResize);
    motion.addEventListener("change", onMotionChange);
    mascot.addEventListener("focus", onFocus);
    mascot.addEventListener("click", bounce);
    motionToggle.addEventListener("click", onMotionToggle);
    document.addEventListener("astro:before-swap", onBeforeSwap);
    document.addEventListener("astro:after-swap", onAfterSwap);
    document.addEventListener("astro:page-load", onPageLoad);
  };
  document.addEventListener("astro:page-load", initMascot);
  initMascot();
</script>
