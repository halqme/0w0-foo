export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: "sm" | "md";
  class?: string;
  marker?: string;
}

const { name, size = "sm", class: className, marker } = Astro.props;
const frame = size === "md" ? iconMd : iconSm;
---

<span
  class:list={[frame, className]}
  data-icon={marker}
  aria-hidden="true"
  set:html={icons[name]}
/>
