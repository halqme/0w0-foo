---
import { getPublishedPosts, sortPostsNewestFirst } from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/ui/BlogCard.astro";

const posts = sortPostsNewestFirst(await getPublishedPosts());
---

<Layout title="HALQME's Blog">
  <section aria-labelledby="blog-title">
    <div class="mb-4 flex items-center justify-between">
      <div aria-hidden="true"></div>
      <a
        href="/tags"
        class="btn-ghost before:content-empty before:i-lucide:tags text-sm"
      >
        Tags
      </a>
    </div>
  </section>
  <div class="mt-4">
    {posts.map((post) => (
      <BlogCard post={post} />
    ))}
  </div>
</Layout>
