---
import { css } from "styled-system/css";
import { link } from "styled-system/recipes";
import { getPublishedPosts, sortPostsNewestFirst } from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/ui/BlogCard.astro";
import { indexHeader, textHeadline } from "../../styles/ui";

const section = css({ py: "8" });

const posts = sortPostsNewestFirst(await getPublishedPosts());
---

<Layout title="Blog" description="趣味とか気になったこととか">
  <section aria-labelledby="blog-title" class={section}>
    <div class={indexHeader}>
      <h1 id="blog-title" class={textHeadline}>
        Blog
      </h1>
      <a href="/blog/tags/" class={link({ kind: "action" })}>
        Tags
      </a>
    </div>
    <div>
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
</Layout>
