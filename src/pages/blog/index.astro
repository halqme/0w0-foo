---
import { getPublishedPosts, sortPostsNewestFirst } from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/ui/BlogCard.astro";

const posts = sortPostsNewestFirst(await getPublishedPosts());
---

<Layout title="HALQME's Blog">
  <section aria-labelledby="blog-title" class="py-8">
    <div class="index-header">
      <h1 id="blog-title" class="text-headline">
        Blog
      </h1>
      <a href="/tags" class="text-action">
        Tags
      </a>
    </div>
    <div>
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
</Layout>
