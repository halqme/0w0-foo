---
import { css } from "styled-system/css";
import { link } from "styled-system/recipes";
import { getPublishedPosts, sortPostsNewestFirst } from "../../../lib/blog";
import BlogCard from "../../../components/ui/BlogCard.astro";
import { slugifyTag } from "../../../lib/tag";
import Layout from "../../../layouts/Layout.astro";
import { indexHeader, textHeadline } from "../../../styles/ui";

const section = css({ py: "8" });
const heading = css({ minW: "0", overflowWrap: "anywhere" });
const count = css({
  textAlign: "center",
  fontSize: "sm",
  lineHeight: "1.25rem",
  color: "muted",
});
const list = css({ mt: "8" });

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Map<string, string>();

  posts.forEach((post) => {
    post.data.topics.forEach((tag: string) => {
      const slug = slugifyTag(tag);
      if (!tags.has(slug)) {
        tags.set(slug, tag);
      }
    });
  });

  return [...tags.entries()].map(([tag, label]) => {
    const filteredPosts = sortPostsNewestFirst(
      posts.filter((post) =>
        post.data.topics.some((entry: string) => slugifyTag(entry) === tag),
      ),
    );
    return {
      params: { tag },
      props: { label, posts: filteredPosts, tag },
    };
  });
}

const { tag } = Astro.params;
const { label, posts } = Astro.props;
---

<Layout title={`Blog | #${label}`}>
  <section aria-labelledby="tag-title" class={section}>
    <div class={indexHeader}>
      <h1 id="tag-title" class:list={[textHeadline, heading]}>
        {label}
      </h1>
      <a href="/blog/tags/" class={link({ kind: "action" })}>
        Tags
      </a>
    </div>
    <p class={count}>{posts.length} 件の記事</p>

    <div class={list}>
      {posts.map((post) => (
        <BlogCard post={post} activeTag={tag} />
      ))}
    </div>
  </section>
</Layout>
