---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Tag from "../../components/ui/Tag.astro";
import ThingsRoute from "../../components/things/ThingsRoute.astro";
import Layout from "../../layouts/Layout.astro";

const things = await getCollection("things");

const categoryCounts = new Map<string, number>();
for (const thing of things) {
  const category = thing.data.category;
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()].toSorted((a, b) => {
  if (b[1] !== a[1]) {
    return b[1] - a[1];
  }
  return a[0].localeCompare(b[0], "ja");
});
---

<Layout title="Things" description="気に入っているデバイスの一覧">
  <section aria-labelledby="things-title" class="py-8">
    <div class="index-header">
      <h1 id="things-title" class="text-headline">
        Things
      </h1>
    </div>
    {things.length && (
      <div data-things-catalog>
        <nav
          class="mb-8 flex flex-wrap justify-center gap-x-6 gap-y-2"
          aria-label="種別で絞り込む"
        >
          <Tag
            label="All"
            class="focused"
            href="/things"
            data-thing-filter=""
            count={things.length}
            aria-current="page"
          />
          <span class="text-muted">|</span>
          {categories.map(([category, count]) => (
            <Tag
              label={category}
              class="focused"
              href={`/things?category=${encodeURIComponent(category)}`}
              count={count}
              data-thing-filter={category}
            />
          ))}
        </nav>
        <div class="grid gap-y-6 sm:grid-cols-3 sm:gap-x-8">
          {things
            .toSorted((a, b) => a.data.title.localeCompare(b.data.title))
            .toSorted((a, b) => a.data.maker.localeCompare(b.data.maker))
            .map((thing) => (
              <article
                transition:name={`thing-card-${thing.id}`}
                class="thing-card min-w-0 py-6"
                data-thing
                data-category={thing.data.category}
              >
                <a
                  href={`/things/${thing.id}`}
                  data-thing-link
                  class="focused block"
                >
                  <div
                    transition:name={`thing-image-${thing.id}`}
                    class="thing-image flex h-40 w-full items-center justify-center bg-transcale"
                  >
                    <Image
                      src={thing.data.image}
                      alt={thing.data.title}
                      class="pointer-events-none h-36 w-auto max-w-full object-contain"
                      loading="eager"
                    />
                  </div>
                  <h2 class="list-title mt-4">{thing.data.title}</h2>
                  <p class="text-label mt-1 [overflow-wrap:anywhere]">
                    {thing.data.maker}
                  </p>
                </a>
              </article>
            ))}
        </div>
        <ThingsRoute />
      </div>
    )}
  </section>
</Layout>
