---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { css } from "styled-system/css";
import Tag from "../../components/ui/Tag.astro";
import ThingsRoute from "../../components/things/ThingsRoute.astro";
import Layout from "../../layouts/Layout.astro";
import { thingCardTransition, thingImageTransition } from "../../styles/motion";
import {
  focused,
  indexHeader,
  listTitle,
  textHeadline,
  textLabel,
} from "../../styles/ui";

const section = css({ py: "8" });
const filters = css({
  mb: "8",
  display: "flex",
  flexWrap: "wrap",
  justifyContent: "center",
  columnGap: "6",
  rowGap: "2",
});
const grid = css({
  display: "grid",
  rowGap: "6",
  sm: {
    gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
  },
  gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
});
const frame = css({
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
});
const photo = css({
  pointerEvents: "none",
  h: "36",
  w: "auto",
  maxW: "full",
  objectFit: "contain",
});

const things = await getCollection("things");

const categoryCounts = new Map<string, number>();
for (const thing of things) {
  const category = thing.data.category;
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}

const categories = [...categoryCounts.entries()].toSorted((a, b) => {
  if (b[1] !== a[1]) {
    return b[1] - a[1];
  }
  return a[0].localeCompare(b[0], "ja");
});
---

<Layout title="Things" description="気に入っているデバイスの一覧">
  <section aria-labelledby="things-title" class={section}>
    <div class={indexHeader}>
      <h1 id="things-title" class={textHeadline}>
        Things
      </h1>
    </div>
    {things.length && (
      <div data-things-catalog>
        <nav class={filters} aria-label="種別で絞り込む">
          <Tag
            label="All"
            class={focused}
            href="/things/"
            data-thing-filter=""
            count={things.length}
            aria-current="page"
          />
          <span class={css({ color: "muted" })}>|</span>
          {categories.map(([category, count]) => (
            <Tag
              label={category}
              class={focused}
              href={`/things/?category=${encodeURIComponent(category)}`}
              count={count}
              data-thing-filter={category}
            />
          ))}
        </nav>
        <div class={grid}>
          {things
            .toSorted((a, b) => a.data.title.localeCompare(b.data.title))
            .toSorted((a, b) => a.data.maker.localeCompare(b.data.maker))
            .map((thing) => (
              <a
                href={`/things/${thing.id}/`}
                transition:name={`thing-card-${thing.id}`}
                data-thing-link
                data-thing
                data-category={thing.data.category}
                class:list={[focused, frame]}
              >
                <Image
                  transition:name={`thing-image-${thing.id}`}
                  src={thing.data.image}
                  alt={thing.data.title}
                  class={photo}
                  loading="eager"
                />
              </a>
            ))}
        </div>
        <ThingsRoute />
      </div>
    )}
  </section>
</Layout>
