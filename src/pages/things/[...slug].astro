---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { css } from "styled-system/css";
import ThingsRoute from "../../components/things/ThingsRoute.astro";
import Layout from "../../layouts/Layout.astro";
import {
  articleColumn,
  pageHeader,
  textAction,
  textHeadline,
  textLabel,
} from "../../styles/ui";

const article = css({ py: "8" });
const wrap = css({ overflowWrap: "anywhere" });
const frame = css({ display: "grid", placeItems: "center" });
const photo = css({
  mx: "auto",
  display: "block",
  h: "auto",
  maxH: "80",
  w: "auto",
  maxW: "full",
  objectFit: "contain",
});
const lines = css({ display: "grid", gap: "4" });
const line = css({
  fontSize: "sm",
  lineHeight: "1.75rem",
  color: "ink",
  overflowWrap: "anywhere",
});

export async function getStaticPaths() {
  const things = await getCollection("things");
  return things.map((thing) => ({
    params: { slug: thing.id },
    props: { thing },
  }));
}

const { thing } = Astro.props;
---

<Layout
  title={thing.data.title}
  description={thing.data.description[0] ?? thing.data.title}
>
  <article class:list={[articleColumn, article]} aria-labelledby="thing-title">
    <header class={pageHeader}>
      <p class:list={[textLabel, wrap]}>{thing.data.maker}</p>
      <h1 id="thing-title" class:list={[textHeadline, wrap]}>
        {thing.data.title}
      </h1>
    </header>
    <figure>
      <div
        transition:name={`thing-image-${thing.id}`}
        class:list={["thing-image", frame]}
      >
        <Image
          src={thing.data.image}
          alt={thing.data.title}
          class={photo}
          loading="eager"
        />
      </div>
      <div class={css({ w: "full", display: "inline-flex", justifyContent: "flex-end" })}>
        <a
          href={thing.data.source}
          class:list={["text-action", textAction]}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${thing.data.title}の画像の出典`}
        >
          reference
        </a>
      </div>
    </figure>
    {thing.data.description.length > 0 && (
      <div class={lines}>
        {thing.data.description.map((entry) => (
          <p class={line}>{entry}</p>
        ))}
      </div>
    )}
    <ThingsRoute />
  </article>
</Layout>
