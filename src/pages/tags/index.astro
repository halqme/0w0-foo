---
import { css } from "styled-system/css";
import { getPublishedPosts, sortPostsNewestFirst } from "../../lib/blog";
import BlogCard from "../../components/ui/BlogCard.astro";
import Tag from "../../components/ui/Tag.astro";
import { slugifyTag } from "../../lib/tag";
import Layout from "../../layouts/Layout.astro";
import {
  indexHeader,
  textAction,
  textBody,
  textHeadline,
} from "../../styles/ui";

const section = css({ py: "8" });
const tagRow = css({
  display: "flex",
  flexWrap: "wrap",
  justifyContent: "center",
  columnGap: "6",
  rowGap: "2",
});
const posts = css({ mt: "8", pt: "4" });

const published = sortPostsNewestFirst(await getPublishedPosts());

const tagCounts = published.reduce((acc, post) => {
  post.data.topics.forEach((tag: string) => {
    const slug = slugifyTag(tag);
    const current = acc.get(slug);
    if (current) {
      current.count += 1;
      return;
    }
    acc.set(slug, { count: 1, label: tag });
  });
  return acc;
}, new Map<string, { count: number; label: string }>());

const sortedTags = [...tagCounts.entries()].toSorted((a, b) => {
  if (b[1].count !== a[1].count) {
    return b[1].count - a[1].count;
  }
  return a[1].label.localeCompare(b[1].label);
});
---

<Layout title="Blog | All Tags">
  <section aria-labelledby="tags-title" class={section}>
    <div class={indexHeader}>
      <h1 id="tags-title" class={textHeadline}>
        Tags
      </h1>
      <a href="/blog" class:list={["text-action", textAction]}>
        Blog
      </a>
    </div>

    {sortedTags.length === 0 ? (
      <p class={textBody}>タグがありません。</p>
    ) : (
      <div class={tagRow}>
        {sortedTags.map(([slug, tag]) => (
          <Tag label={tag.label} href={`/tags/${slug}`} count={tag.count} />
        ))}
      </div>
    )}

    <div class={posts}>
      {published.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
</Layout>
