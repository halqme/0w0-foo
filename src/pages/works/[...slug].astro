---
import { getCollection, render } from "astro:content";
import { css } from "styled-system/css";
import Layout from "../../layouts/Layout.astro";
import {
  articleColumn,
  pageHeader,
  textAction,
  textHeadline,
  textLabel,
} from "../../styles/ui";

const article = css({ py: "8" });
const titleText = css({ overflowWrap: "anywhere" });
const description = css({
  fontSize: "sm",
  lineHeight: "relaxed",
  color: "muted",
  overflowWrap: "anywhere",
});
const tags = css({
  display: "flex",
  flexWrap: "wrap",
  justifyContent: "center",
  columnGap: "4",
  rowGap: "1",
  overflowWrap: "anywhere",
});
const links = css({
  display: "flex",
  flexWrap: "wrap",
  justifyContent: "center",
  columnGap: "4",
  rowGap: "1",
});
const body = css({ py: "8" });
const content = css({ maxW: "none", minW: "0" });

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<Layout title={work.data.title} description={work.data.description}>
  <article class:list={[articleColumn, article]} aria-labelledby="work-title">
    <header class={pageHeader}>
      <h1 id="work-title" class:list={[textHeadline, titleText]}>
        {work.data.title}
      </h1>
      <p class={description} lang="en">
        {work.data.description}
      </p>
      {work.data.tags.length > 0 && (
        <ul class:list={[textLabel, tags]} aria-label="使用技術">
          {work.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
      <div class={links}>
        <a
          href={work.data.repo}
          class={textAction}
          target="_blank"
          rel="noopener noreferrer"
        >
          Repository
        </a>
        {work.data.url && (
          <a
            href={work.data.url}
            class={textAction}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open Project
          </a>
        )}
      </div>
    </header>
    <div class={body}>
      <div class:list={["post-content", "prose", "prose-sm", content]}>
        <Content />
      </div>
    </div>
  </article>
</Layout>
