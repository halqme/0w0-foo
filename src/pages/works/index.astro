---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const works = await getCollection("works");
---

<Layout title="Works" description="制作したプロジェクトの一覧">
  <section aria-labelledby="works-title" class="py-8">
    <div class="index-header">
      <h1 id="works-title" class="text-headline">
        Works
      </h1>
    </div>
    {works.length === 0 ? (
      <p class="text-sm text-muted">プロジェクトはまだありません。</p>
    ) : (
      <div class="grid gap-y-6 sm:grid-cols-2 sm:gap-x-8">
        {works.map((work) => (
          <article class="min-w-0 border-t border-line py-6">
            <h2 class="list-title">
              <a href={`/works/${work.id}`} class="link-text focused">
                {work.data.title}
              </a>
            </h2>
            <p
              class="mt-2 text-sm leading-normal text-muted [overflow-wrap:anywhere] sm:leading-7"
              lang="en"
            >
              {work.data.description}
            </p>
            {work.data.tags.length > 0 && (
              <ul
                class="text-label mt-2 flex flex-wrap gap-x-3 gap-y-1 list-none [overflow-wrap:anywhere]"
                aria-label="使用技術"
              >
                {work.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>
